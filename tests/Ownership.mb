let appName = "Matchbox"
let numbers = List(1, 2, 3)

var count = 0
var users = List("Alice", "Bob")

func readAppName() {
    # OK: Shared access
    print(appName)
}

func readNumbers() {
    # OK: Shared access
    print(numbers[0])
}

func writeNumbers() {
    # OK: Exclusive access mutates the value without rebinding it
    numbers.add(4)
}

func replaceAppName() {
    # Error: Let bindings cannot be reassigned
    # appName = "Other"
}

func readCount() {
    # OK: Shared access
    print(count)
}

func writeCount() {
    # OK: Exclusive access allows mutation
    count += 1
}

func readUsers() {
    # OK: Shared access
    print(users.count())
}

func writeUsers() {
    # OK: Exclusive access allows mutation
    users.add("Charlie")
}

func replaceUsers() {
    # OK: Var may be reassigned with exclusive access
    users = List("Charlie")
}

func updateCount() {
    # OK: Exclusive access propagates through the call
    writeCount()
}

func moduleLetAccess() {
    # OK: Shared access
    readAppName()
    readNumbers()

    # OK: Exclusive access may mutate a let value
    writeNumbers()

    # Error: Let bindings cannot be reassigned
    # appName = "Other"
    # numbers = List(4, 5, 6)
}

func moduleVarAccess() {
    # OK: Var supports reading, mutation, and rebinding
    readCount()
    writeCount()

    readUsers()
    writeUsers()
    replaceUsers()
}

func sharedTasks() {
    # OK: Multiple shared accesses may overlap
    let first = spawn readCount()
    let second = spawn readCount()

    await first
    await second
}

func sharedExclusiveConflict() {
    let task = spawn readCount()

    # Error: Task holds shared access to count
    # writeCount()

    await task

    # OK: Shared access ended at await
    writeCount()
}

func letSharedExclusiveConflict() {
    let task = spawn readNumbers()

    # Error: Task holds shared access to numbers
    # writeNumbers()

    await task

    # OK: Shared access ended at await
    writeNumbers()
}

func exclusiveConflict() {
    let first = spawn writeCount()

    # Error: First holds exclusive access to count
    # let second = spawn writeCount()

    await first

    # OK: First exclusive access has ended
    let second = spawn writeCount()
    await second
}

func letExclusiveConflict() {
    let first = spawn writeNumbers()

    # Error: First holds exclusive access to numbers
    # let second = spawn writeNumbers()

    await first

    # OK: First exclusive access has ended
    let second = spawn writeNumbers()
    await second
}

func sequentialExclusiveAccess() {
    # OK: Exclusive accesses do not overlap
    let first = spawn writeCount()
    await first

    let second = spawn writeCount()
    await second
}

func independentAccess() {
    # OK: Tasks access different values
    let first = spawn writeCount()
    let second = spawn writeUsers()

    await first
    await second
}

func propagatedConflict() {
    let task = spawn updateCount()

    # Error: UpdateCount requires exclusive access to count
    # readCount()
    # writeCount()

    await task

    # OK: Propagated exclusive access has ended
    readCount()
}

func readList(values: &List<int>) {
    # OK: Shared references permit reading
    print(values.count())
}

func appendList(values: ^List<int>) {
    # OK: Exclusive references permit mutation
    values.add(4)
}

func returnReference(values: &List<int>) -> &List<int> {
    # OK: Returned reference has the same lifetime as the input reference
    return values
}

func returnLocalReference() {
    let values = List(1, 2, 3)

    # Error: Reference to local storage cannot escape the function
    # return &values
}

func sharedReference() {
    var values = List(1, 2, 3)
    let reference = &values

    # OK: Shared access permits reading
    print(reference.count())

    # Error: Shared references cannot mutate
    # reference.add(4)

    # OK: Shared access ended after its final use
    values.add(4)
}

func exclusiveReference() {
    let values = List(1, 2, 3)

    # OK: Let prevents rebinding, not mutation
    appendList(^values)

    print(values.count())

    # Error: Let bindings cannot be reassigned
    # values = List(5, 6, 7)
}

func sharedTaskReference() {
    let values = List(1, 2, 3)
    let task = spawn readList(&values)

    # OK: Another shared access may overlap
    print(values.count())

    await task
}

func exclusiveTaskReference() {
    let values = List(1, 2, 3)
    let task = spawn appendList(^values)

    # Error: Task holds exclusive access to values
    # print(values.count())
    # values.add(5)

    await task

    # OK: Exclusive access ended at await
    values.add(5)
}

func consume(values: List<int>) {
    print(values.count())
}

func moveIntoCall() {
    let values = List(1, 2, 3)

    # OK: Non-copyable values move into the function call
    consume(values)

    # Error: Values was moved
    # print(values.count())
}

func moveIntoTask() {
    let values = List(1, 2, 3)

    # OK: Non-copyable values move into the task
    let task = spawn consume(values)

    # Error: Values was moved into the task
    # print(values.count())

    await task
}

func consumeInt(value: int) {
    print(value)
}

func copyIntoCall() {
    let value = 42

    # OK: Copyable arguments are copied into the call
    consumeInt(value)

    # OK: Original remains usable after the call
    print(value)
}

struct CopyPoint {
    x: int
    y: int
}

struct Batch {
    values: List<int>
}

func consumePoint(point: CopyPoint) {
    print(point.x, point.y)
}

func consumeBatch(batch: Batch) {
    print(batch.values.count())
}

func deepCopyability() {
    let point = CopyPoint(1, 2)

    # OK: A value without drop behavior is copyable when all fields are copyable
    consumePoint(point)
    print(point.x)

    let batch = Batch(List(1, 2, 3))

    # OK: A value containing a non-copyable value moves into the call
    consumeBatch(batch)

    # Error: Batch was moved because its list is non-copyable
    # print(batch.values.count())
}

func readBatch(batch: &Batch) {
    # OK: Shared access permits deep reads
    print(batch.values.count())

    # Error: Shared access cannot mutate a nested value
    # batch.values.add(4)
}

func appendAndReturn(values: List<int>) -> List<int> {
    values.add(4)
    return values
}

func returnOwnership() {
    let values = List(1, 2, 3)
    let task = spawn appendAndReturn(values)

    # Error: Values is owned by the task
    # print(values.count())

    # OK: Ownership returns through the task result
    let updated = await task

    print(updated.count())
}

class Resource {
    name: string

    func drop() {
        print("Dropped ", name)
    }
}

func consumeResource(resource: Resource) {
}

func destructionOnReturn(condition: bool) {
    let resource = Resource("return")

    if condition {
        # OK: Resource is dropped before returning
        return
    }

    # OK: Resource is dropped at the end of the function
}

func destructionOnThrow() {
    try {
        let resource = Resource("throw")

        # OK: Resource is dropped while unwinding
        throw "Failure"
    } catch {
        print("Caught failure")
    }
}

func destructionAfterMove() {
    let resource = Resource("move")

    # OK: Ownership and the drop obligation move into the call
    consumeResource(resource)

    # Error: Moved values are not dropped again by the caller
    # resource.drop()
}

func awaitOnce() {
    let task = spawn writeCount()

    # OK: Await consumes the task handle
    await task

    # Error: Task has already been awaited
    # await task
}

func unawaitedTask() {
    # Error: Task must be awaited before leaving the function
    # let task = spawn writeCount()
}

func writeThenFail() {
    writeCount()
    throw "Task failed"
}

func failedTask() {
    let task = spawn writeThenFail()

    try {
        # OK: Await consumes the failed task handle and propagates its error
        await task
    } catch {
        # OK: Task access ended before its error was caught
        writeCount()
    }
}

func cancelTask() {
    let task = spawn writeCount()

    # OK: Cancellation requests that the task stop
    task.cancel()

    # Error: Cancellation does not end the task's access
    # readCount()

    try {
        # OK: Cancelled tasks must still be awaited
        await task
    } catch {
    }

    # OK: Task access ended after await
    readCount()
}

func throwWithActiveTask() {
    let task = spawn writeCount()

    # OK: Exceptional unwinding cancels and joins active tasks
    throw "Parent failed"
}

func exceptionalTaskCleanup() {
    try {
        throwWithActiveTask()
    } catch {
        # OK: Child task completed before the error escaped its scope
        writeCount()
    }
}

func conditionalAwait(condition: bool) {
    let task = spawn writeCount()

    if condition {
        await task
    } else {
        await task
    }

    # OK: Task completed on every branch
    readCount()
}

protocol CounterOperation {
    func run()
}

class IncrementOperation {
    func run() {
        writeCount()
    }
}

func invokeOperation(operation: &CounterOperation) {
    # OK: Dynamic calls inherit the effects of every possible target
    operation.run()
}

func dynamicEffect(operation: &CounterOperation) {
    let task = spawn invokeOperation(operation)

    # Error: A possible dynamic target requires exclusive access to count
    # readCount()

    await task
}

moduleLetAccess()
moduleVarAccess()
sharedTasks()
sharedExclusiveConflict()
letSharedExclusiveConflict()
exclusiveConflict()
letExclusiveConflict()
sequentialExclusiveAccess()
independentAccess()
propagatedConflict()
sharedReference()
exclusiveReference()
sharedTaskReference()
exclusiveTaskReference()
moveIntoCall()
moveIntoTask()
copyIntoCall()
deepCopyability()
returnOwnership()
destructionOnReturn(false)
destructionOnThrow()
destructionAfterMove()
awaitOnce()
unawaitedTask()
failedTask()
cancelTask()
exceptionalTaskCleanup()
conditionalAwait(true)
