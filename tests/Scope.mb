var x = 10
let y = 20

func updateGlobal() {
    print(x)
    x = 15
    print(x)
}

func testLocal(x: int) {
    print(x)
    print(y)

    let local = 200
    print(local)

    func inner(x: int) {
        print(x)
        print(y)
    }

    inner(300)

    print(x)
    print(local)
}

func testShadowing() {
    print(x)

    var x = 400

    print(x)
    x = 450
    print(x)

    func inner() {
        print(x)
        x = 25
        print(x)
    }

    inner()

    print(x)
}

print(x)
print(y)

updateGlobal()

print(x)

testLocal(100)
testShadowing()

print(x)
print(y)
