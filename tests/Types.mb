let i: int = 0              # Platform-specific signed integer
let i: uint = 0             # Platform-specific unsigned integer
let i: int8 = 0             # 8-bit signed integer
let i: int16 = 0            # 16-bit signed integer
let i: int32 = 0            # 32-bit signed integer
let i: int64 = 0            # 64-bit signed integer
let i: uint8 = 0            # 8-bit unsigned integer
let i: uint16 = 0           # 16-bit unsigned integer
let i: uint32 = 0           # 32-bit unsigned integer
let i: uint64 = 0           # 64-bit unsigned integer
let f: float = 0.0          # 32-bit floating-point number
let f: double = 0.0         # 64-bit floating-point number
let c: char = 'a'           # 32-bit Unicode character
let s: string = "abc"       # Sequence of Unicode characters
let b: bool = false         # Boolean value: true or false
var v: void                 # No return type
