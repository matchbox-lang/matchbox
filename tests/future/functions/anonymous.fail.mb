type Operation = (i32, i32) -> i32

struct Point {
    x: i32
    y: i32
}

let add: Operation = (a, b) in a * b

func invoke(a, b, op: Operation) {
    print(op(a, b))
}

func invoke(point: Point) {
    invoke(...point, (a, b) in a + b)
}

invoke(1, 2, func(a, b) {
    return a + b
})

invoke(1, 2, (a, b) in a + b)
invoke(1, 2, mul)
invoke({x: 1, y: 2})
