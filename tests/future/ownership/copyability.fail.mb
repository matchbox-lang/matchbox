struct Point {
    x: i32
    y: i32
}

struct Batch {
    values: List<i32>
}

func consume_point(point: Point) {
    print(point.x, point.y)
}

func consume_batch(batch: Batch) {
    print(batch.values.count())
}

func read_batch(batch: &Batch) {
    print(batch.values.count())
}

let point = Point(1, 2)

consume_point(point)
print(point.x)

let batch = Batch(List(1, 2, 3))

consume_batch(batch)
