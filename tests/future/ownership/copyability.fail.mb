struct Point {
    x: i32
    y: i32
}

struct Batch {
    values: List<i32>
}

func consumePoint(point: Point) {
    print(point.x, point.y)
}

func consumeBatch(batch: Batch) {
    print(batch.values.count())
}

func readBatch(batch: &Batch) {
    print(batch.values.count())
}

let point = Point(1, 2)

consumePoint(point)
print(point.x)

let batch = Batch(List(1, 2, 3))

consumeBatch(batch)
