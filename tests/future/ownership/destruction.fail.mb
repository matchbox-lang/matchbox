class Resource {
    name: string

    func drop() {
        print("Dropped ", name)
    }
}

func consume_resource(resource: Resource) {
    print(resource.name)
}

func process(result) {
    let resource = Resource("return or error")
    let value = try result

    return Success(value)
}

let success = Success(5)
let failure = Error("Failure")
let resource = Resource("move")

process(success)
process(failure)
consume_resource(resource)
