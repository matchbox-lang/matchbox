class Resource {
    name: string

    func drop() {
        print("Dropped ", name)
    }
}

func consume_resource(resource: Resource) {
}

func destruction_on_return(condition: bool) {
    let resource = Resource("return")

    if condition {
        return
    }
}

func destruction_on_throw() {
    try {
        let resource = Resource("throw")
        throw "Failure"
    } catch {
        print("Caught failure")
    }
}

func destruction_after_move() {
    let resource = Resource("move")
    
    consume_resource(resource)
}

destruction_on_return(false)
destruction_on_throw()
destruction_after_move()
