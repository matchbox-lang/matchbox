var count = 0

func read_count() {
    print(count)
}

func write_count() {
    count += 1
}

func write_then_fail() -> Result[i32, string] {
    write_count()

    return Error("Task failed")
}

func await_once() {
    let task = spawn write_count()
    
    await task
}

func failed_task() {
    let task = spawn write_then_fail()

    match await task {
        case Success(value):
            print(value)
        case Error(error):
            print(error)
            write_count()
    }
}

func cancel_task() {
    let task = spawn write_count()

    task.cancel()

    await task

    read_count()
}

func conditional_await(condition: bool) {
    let task = spawn write_count()

    if condition {
        await task
    } else {
        await task
    }

    read_count()
}

await_once()
failed_task()
cancel_task()
conditional_await(true)
