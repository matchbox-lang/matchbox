let signedSize: isize = 0       // Pointer-sized signed integer
let unsignedSize: usize = 0     // Pointer-sized unsigned integer

let signed8: i8 = 0             // 8-bit signed integer
let signed16: i16 = 0           // 16-bit signed integer
let signed32: i32 = 0           // 32-bit signed integer
let signed64: i64 = 0           // 64-bit signed integer

let unsigned8: u8 = 0           // 8-bit unsigned integer
let unsigned16: u16 = 0         // 16-bit unsigned integer
let unsigned32: u32 = 0         // 32-bit unsigned integer
let unsigned64: u64 = 0         // 64-bit unsigned integer

let float32: f32 = 0.0          // 32-bit floating-point number
let float64: f64 = 0.0          // 64-bit floating-point number

let character: char = 'a'       // 32-bit Unicode character
let text: string = "abc"        // Sequence of Unicode characters

let boolean: bool = false       // Boolean value: true or false

func() -> void                  // No return value
