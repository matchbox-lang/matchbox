let i: size = 0             # Platform-specific signed integer
let i: offset = 0           # Platform-specific unsigned integer
let i: i8 = 0               # 8-bit signed integer
let i: i16 = 0              # 16-bit signed integer
let i: i32 = 0              # 32-bit signed integer
let i: i64 = 0              # 64-bit signed integer
let i: u8 = 0               # 8-bit unsigned integer
let i: u16 = 0              # 16-bit unsigned integer
let i: u32 = 0              # 32-bit unsigned integer
let i: u64 = 0              # 64-bit unsigned integer
let f: f32 = 0.0            # 32-bit floating-point number
let f: f64 = 0.0            # 64-bit floating-point number
let c: char = 'a'           # 32-bit Unicode character
let s: string = "abc"       # Sequence of Unicode characters
let b: bool = false         # Boolean value: true or false
func() -> void              # No return value
