let x: int8 = 100
let y = 10.5

let i: int = x # Implicit OK

let i: int = y # Implicit Error

let i = int(y) # Explicit OK

let i = char(y) # Explicit Error

let i: int64 = int(y) # Explicit OK > Implicit OK

let s: string = 'c' # Implicit OK

let d: Derived = Derived()

let b: Base = d # Implicit OK
