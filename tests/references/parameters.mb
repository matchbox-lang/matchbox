func takeValue(n: int) {
    print(n)
}

func takeShared(n: &int) {
    print(n)
}

func takeExclusive(n: ^int) {
    print(n)
}

func takeReferences(a: &int, b: ^int) {
    print(a)
    print(b)
}

var value = 10
var shared = &value

takeValue(value)
takeShared(value)
takeShared(&value)
takeValue(shared)
takeShared(shared)

var exclusiveValue = 20
var exclusive = ^exclusiveValue

takeValue(exclusive)
takeExclusive(exclusive)

var a = 30
var b = 40
takeReferences(&a, ^b)
