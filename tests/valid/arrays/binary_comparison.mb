test "numeric array comparisons" {
    let a = [1, 3, 2]
    let b = [2, 3, 1]

    assert((a < b) == [true, false, false])
    assert((a <= b) == [true, true, false])
    assert((a > b) == [false, false, true])
    assert((a >= b) == [false, true, true])
    assert((a <=> b) == [-1, 0, 1])
}

test "boolean array operations" {
    assert(([true, false] and [false, true]) == [false, false])
    assert(([true, false] or [false, true]) == [true, true])
}

test "character array comparisons" {
    assert((['a', 'z'] < ['b', 'y']) == [true, false])
}
