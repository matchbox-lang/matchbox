var order = 0

func element(value: i32) -> i32 {
    order = order * 10 + value

    return value
}

func flags(value: i32) -> bool[1] {
    element(value)

    return [false]
}

[1] + [2];
[element(1)] + [element(2)]

assert(order == 12)

flags(3) and flags(4)

assert(order == 1234);

[element(5)] == [[element(6)]]

assert(order == 123456)
