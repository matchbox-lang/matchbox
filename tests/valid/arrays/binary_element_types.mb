let small: i8[2] = [-8, 9]
let unsigned: u8[2] = [2, 3]
let wide = i64[2](-6000000000)
let huge = u64[2](18446744073709551615)
let floats = f64[2](1.5)
let singles = f32[2](2.5)

assert((small / unsigned) == [-4, 3])
assert((small < unsigned) == [true, false])
assert((wide + wide) == i64[2](-12000000000))
assert(wide == i64[2](-6000000000))
assert((huge / u64[2](3)) == u64[2](6148914691236517205))
assert((huge > u64[2](1)) == bool[2](true))
assert((floats + singles) == f64[2](4.0))
assert((floats < singles) == bool[2](true))
let text = ['a', 'b'] + ['x', 'y']

print(text)
