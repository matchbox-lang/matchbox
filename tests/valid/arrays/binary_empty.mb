test "binary empty" {
    let empty = i32[0](0)
    let matrix = i32[2][0](0)
    let sum = empty + empty
    let comparison = matrix < matrix

    assert(empty == empty)
    assert(not (empty != empty))
    assert(matrix == matrix)
    assert(matrix != empty)
    assert(sum == empty)
    assert(comparison == bool[2][0](false))
}
