test "array equality and shape comparisons" {
    let a = [1, 2, 3]
    let b = [1, 2, 3]
    let c = [[1, 2, 3]]

    assert(a == b)
    assert(not (a != b))
    assert(not (a == c))
    assert(a != c)
    assert(a != [1, 2])
    assert(a != [1, 2, 4])
    assert(([[1, 2], [3, 4]]) == [[1, 2], [3, 4]])
    assert([[1, 2], [3, 4]] != [[1, 2], [3, 5]])
    assert(a === b)
    assert(not (a !== b))
}

test "array arithmetic result independence" {
    let a = [1, 2, 3]
    let b = [1, 2, 3]
    let sum = a + b
    
    sum[0] = 9

    assert(a[0] == 1)
    assert(b[0] == 1)
}
