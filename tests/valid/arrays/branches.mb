test "conditional array moves" {
    let a = [1, 2]
    let b = [3, 4]
    var condition = true

    let chosen = if condition {
        a
    } else {
        b
    }

    chosen[0] = 10

    assert(chosen[0] == 10)
}

test "typed conditional array literals" {
    var condition = true

    let values: u8[2] = if condition {
        [1, 2]
    } else {
        [3, 4]
    }

    assert(values[1] == 2)
}

test "same array conditional moves" {
    var condition = true
    let c = [5, 6]

    let same = if condition {
        c
    } else {
        c
    }

    assert(same[1] == 6)
}

test "match moves from the same array" {
    var condition = true
    let d = [7, 8]

    let selected = match condition {
        case true: d
        case false: d
    }

    assert(selected[0] == 7)
}

test "typed match array literals" {
    var condition = true

    let matched: u8[2][2] = match condition {
        case true: [[1, 2], [3, 4]]
        case false: [[5, 6], [7, 8]]
    }

    assert(matched[1][1] == 4)
}
