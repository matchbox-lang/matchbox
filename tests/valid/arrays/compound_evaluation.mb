var calls = 0
let values = [1, 2]

func make() -> i32[2] {
    calls += 1

    return [3, 4]
}

func update() {
    values += make()
}

update()
assert(calls == 1 and values == [4, 6])

func local() {
    let numbers = [2, 3]

    numbers *= numbers
    numbers += make()
    assert(numbers == [7, 13])
}

local()
assert(calls == 2)
