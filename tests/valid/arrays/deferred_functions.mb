func make() -> i32[2][2] {
    let arr: i32[2][2]
    arr = [1, 2, 3, 4]
    arr[1][1] = 10

    return arr
}

let global: i32[2]

func initialize() -> i32 {
    global = [7, 8]
    global[1] = 9

    return 0
}

test "deferred functions" {
    let made = make()

    assert(made[1][1] == 10)

    let status = initialize()

    assert(status == 0)
    assert(global[0] == 7)
    assert(global[1] == 9)
}
