test "narrow signed array elements" {
    let bytes: i8[3] = [-128, 0, 127]
    let shorts: i16[3] = [-32768, 0, 32767]

    bytes[1] = -1
    shorts[1] = -2

    let widened_byte: i64 = bytes[0]
    let widened_short: i32 = shorts[1]

    assert(bytes[0] == -128)
    assert(bytes[1] == -1)
    assert(bytes[2] == 127)
    assert(shorts[0] == -32768)
    assert(shorts[1] == -2)
    assert(shorts[2] == 32767)
    assert(widened_byte == -128)
    assert(widened_short == -2)

    let byte_text = string(bytes)

    assert(byte_text == "[-128, -1, 127]")

    let short_text = string(shorts)

    assert(short_text == "[-32768, -2, 32767]")
}

test "narrow unsigned array elements" {
    let unsigned_bytes: u8[2] = [0, 255]
    let unsigned_shorts: u16[2] = [0, 65535]

    unsigned_bytes[0] = 254
    unsigned_shorts[0] = 65534

    assert(unsigned_bytes[0] == 254)
    assert(unsigned_bytes[1] == 255)
    assert(unsigned_shorts[0] == 65534)
    assert(unsigned_shorts[1] == 65535)

    let byte_text = string(unsigned_bytes)

    assert(byte_text == "[254, 255]")

    let short_text = string(unsigned_shorts)

    assert(short_text == "[65534, 65535]")
}

test "f32 array elements" {
    let singles: f32[2] = [1.25, -2.5]
    singles[0] = -3.75

    assert(singles[0] == -3.75)
    assert(singles[1] == -2.5)

    let text = string(singles)

    assert(text == "[-3.75, -2.5]")
}
