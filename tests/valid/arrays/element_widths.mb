let bytes: i8[3] = [-128, 0, 127]
let shorts: i16[3] = [-32768, 0, 32767]

bytes[1] = -1
shorts[1] = -2

let widened_byte: i64 = bytes[0]
let widened_short: i32 = shorts[1]

assert(bytes[0] == -128 and bytes[1] == -1 and bytes[2] == 127)
assert(shorts[0] == -32768 and shorts[1] == -2 and shorts[2] == 32767)
assert(widened_byte == -128 and widened_short == -2)
print(string(bytes))
print(string(shorts))

let unsigned_bytes: u8[2] = [0, 255]
let unsigned_shorts: u16[2] = [0, 65535]

unsigned_bytes[0] = 254
unsigned_shorts[0] = 65534

assert(unsigned_bytes[0] == 254 and unsigned_bytes[1] == 255)
assert(unsigned_shorts[0] == 65534 and unsigned_shorts[1] == 65535)
print(string(unsigned_bytes))
print(string(unsigned_shorts))

let singles: f32[2] = [1.25, -2.5]
singles[0] = -3.75

assert(singles[0] == -3.75 and singles[1] == -2.5)
print(string(singles))
