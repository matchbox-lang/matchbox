test "empty array initialization" {
    let empty: i32[0] = []
    let defaults: i32[2][0]
    defaults = [[], []]

    let expected_empty: i32[0] = []

    assert(empty == expected_empty)

    let expected_defaults: i32[2][0] = [[], []]

    assert(defaults == expected_defaults)
}

test "array row setup and replacement" {
    let first = [1, 2]
    let second = [3, 4]
    let matrix: i32[2][2] = [first, second]

    assert(matrix[1][0] == 3)

    let row = [5, 6]
    matrix[0] = row

    assert(matrix[0][1] == 6)
}
