func check_widening(signed: i8, unsigned: u8, integer: i32, floating: f32) {
    let signed_values = i64[2](signed)
    let unsigned_values = i16[2](unsigned)
    let small_floats = f32[2](signed)
    let integer_floats = f64[2](integer)
    let wide_floats = f64[2](floating)

    assert(signed_values[1] == -25 and unsigned_values[1] == 255)
    assert(small_floats[1] == -25.0 and integer_floats[1] == 1000.0 and wide_floats[1] == 1.5)
}

check_widening(-25, 255, 1000, 1.5)

let minimum = i8[2](-128)
let maximum = u8[2](255)
let exact = f32[2](16777216)
let characters = char[2]('x')

assert(minimum[1] == -128 and maximum[1] == 255 and exact[1] == 16777216.0)
assert(characters[1] == 'x')

let wrapped_value = u8(-25)
let narrowed_value = i8(511)
let truncated_value = i32(1.5)
let converted_char = char(120)

let wrapped = u8[3](wrapped_value)
let narrowed = i8[2](narrowed_value)
let truncated = i32[2](truncated_value)
let converted_chars = char[2](converted_char)

assert(wrapped[2] == 231 and narrowed[1] == -1 and truncated[1] == 1)
assert(converted_chars[1] == 'x')
