func read(values: &i32[2]) -> i32 {
    return values[1]
}

func mutate(values: ^i32[2]) {
    values[0] = 7
}

func make() -> u8[2] {
    return [10, 20]
}

func make_matrix() {
    return [[1, 2], [3, 4]]
}

func duplicate(values: &i32[2]) -> i32[2] {
    return copy(values)
}

test "array reference parameters" {
    let numbers = [1, 2]
    let read_back = read(&numbers)

    assert(read_back == 2)
    mutate(^numbers)
    assert(numbers[0] == 7)
}

test "typed array returns" {
    let made = make()

    assert(made[1] == 20)
}

test "inferred nested array returns" {
    let matrix = make_matrix()

    assert(matrix[1][1] == 4)
}

test "array copies returned from functions" {
    let numbers = [7, 2]
    let duplicate_numbers = duplicate(&numbers)

    numbers[0] = 8

    assert(duplicate_numbers[0] == 7 and duplicate_numbers[1] == 2)
}

test "array literal copies" {
    let literal_copy = copy([30, 40])

    assert(literal_copy[0] == 30 and literal_copy[1] == 40)
}

test "copies of returned arrays" {
    let made = make()
    let returned_copy = copy(made)

    assert(returned_copy[0] == 10 and returned_copy[1] == 20)
}
