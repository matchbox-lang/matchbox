let a: i32[3]
a = [0, 0, 0]
a[0] = 1
a[1] = 2
a[2] = 3

let b: i32[3] = [4, 5, 6]

assert(a[0] == 1 and a[1] == 2 and a[2] == 3)
assert(b[0] == 4 and b[1] == 5 and b[2] == 6)

let inferred = [10, 20, 30]
let i: usize = 1
let j: u8 = 2

assert(inferred[0] == 10 and inferred[i] == 20 and inferred[j] == 30)

let k: i32 = 1
let converted = usize(k)

assert(inferred[converted] == 20)
print(a, b)

let offset: usize = 1
let final_index: usize = offset + 1

assert(inferred[final_index] == 30)

inferred[offset + 1] = 40

assert(inferred[2] == 40)
