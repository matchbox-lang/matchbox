var calls = 0

func next_value() -> i32 {
    calls += 1

    return calls
}

test "nested initializers" {
    let matrix = [[next_value(), next_value()], [next_value(), next_value()]]

    assert(calls == 4)
    assert(matrix[0][0] == 1)
    assert(matrix[0][1] == 2)
    assert(matrix[1][0] == 3)
    assert(matrix[1][1] == 4)

    let first_value = next_value()
    let second_value = next_value()
    let first_fill = u16(first_value)
    let second_fill = u16(second_value)
    let filled = [u16[2](first_fill), u16[2](second_fill)]
    let cube: i64[2][1][2] = [[[5000000000, 6000000000]], [[7000000000, 8000000000]]]

    assert(calls == 6)
    assert(filled[0][1] == 5)
    assert(filled[1][0] == 6)
    assert(filled[1][1] == 6)
    assert(cube[0][0][1] == 6000000000)
    assert(cube[1][0][0] == 7000000000)
    assert(cube[1][0][1] == 8000000000)
    assert(matrix == [[1, 2], [3, 4]])
    assert(filled == [[5, 5], [6, 6]])
    assert(cube == [[[5000000000, 6000000000]], [[7000000000, 8000000000]]])
}
