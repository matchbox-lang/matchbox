let bytes = u8[257](0)
let shorts = i16[129](0)
let integers = i32[65](0)
let wide = i64[33](0)

bytes[255] = 255
bytes[256] = 128
shorts[127] = -32768
shorts[128] = 32767
integers[63] = -1000
integers[64] = 6000
wide[31] = -6000000000
wide[32] = 7000000000

assert(bytes[255] == 255 and bytes[256] == 128 and bytes[254] == 0)
assert(shorts[127] == -32768 and shorts[128] == 32767 and shorts[126] == 0)
assert(integers[63] == -1000 and integers[64] == 6000 and integers[62] == 0)
assert(wide[31] == -6000000000 and wide[32] == 7000000000 and wide[30] == 0)
