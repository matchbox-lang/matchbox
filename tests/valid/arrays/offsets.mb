test "offsets" {
    let bytes = u8[257](0)
    let shorts = i16[129](0)
    let integers = i32[65](0)
    let wide = i64[33](0)

    bytes[255] = 255
    bytes[256] = 128
    shorts[127] = -32768
    shorts[128] = 32767
    integers[63] = -1000
    integers[64] = 6000
    wide[31] = -6000000000
    wide[32] = 7000000000

    assert(bytes[255] == 255)
    assert(bytes[256] == 128)
    assert(bytes[254] == 0)
    assert(shorts[127] == -32768)
    assert(shorts[128] == 32767)
    assert(shorts[126] == 0)
    assert(integers[63] == -1000)
    assert(integers[64] == 6000)
    assert(integers[62] == 0)
    assert(wide[31] == -6000000000)
    assert(wide[32] == 7000000000)
    assert(wide[30] == 0)
}
