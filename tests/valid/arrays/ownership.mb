func take(values: i32[3]) -> i32[3] {
    values[2] = 30

    return values
}

test "array assignment and call moves" {
    let a = [1, 2, 3]
    let b = a
    b[0] = 10

    assert(b[0] == 10)

    var c: i32[3]
    c = b
    c[1] = 20

    assert(c[0] == 10)
    assert(c[1] == 20)

    let d = take(c)

    assert(d[2] == 30)

    let e = take([4, 5, 6])

    assert(e[0] == 4)
    assert(e[2] == 30)
}

test "independent array copies" {
    let x = [1, 2, 3]
    let y = copy(x)

    x[0] = 10
    y[1] = 20

    assert(x[0] == 10)
    assert(x[1] == 2)
    assert(y[0] == 1)
    assert(y[1] == 20)
    copy(x)

    let z = x

    assert(z[0] == 10)
}
