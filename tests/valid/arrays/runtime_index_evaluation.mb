var calls = 0

func next_index() -> usize {
    let index = usize(calls)
    calls += 1

    return index
}

func replacement() -> i32 {
    assert(calls == 2)

    calls += 1

    return 50
}

test "runtime index evaluation" {
    let matrix: i32[2][2] = [[10, 20], [30, 40]]
    let value = matrix[next_index()][next_index()]

    assert(value == 20 and calls == 2)

    calls = 0
    matrix[next_index()][next_index()] = replacement()

    assert(matrix[0][1] == 50 and calls == 3)

    var index: usize = 0
    let length = len(matrix[index])

    assert(length == 2 and calls == 3)
}
