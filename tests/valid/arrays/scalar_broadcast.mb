test "scalar broadcast" {
    let values = [(10, 20), (30, 40)]

    assert((values + 5) == [(15, 25), (35, 45)])
    assert((5 + values) == [(15, 25), (35, 45)])
    assert((values - 5) == [(5, 15), (25, 35)])
    assert((5 - values) == [(-5, -15), (-25, -35)])
    assert((values / 5) == [(2, 4), (6, 8)])
    assert((100 / values) == [(10, 5), (3, 2)])
    assert((values + (1, 2)) == [(11, 22), (31, 42)])
    assert(((1, 2) - values) == [(-9, -18), (-29, -38)])
    assert(([1, 2] + 5) == [6, 7])
    assert((5 - [1, 2]) == [4, 3])
    assert(([[1, 2], [3, 4]] * 2) == [[2, 4], [6, 8]])
    assert((1, (2, 3)) + 5 == (6, (7, 8)))
    assert(values == [(10, 20), (30, 40)])
}
