test "nested collection operators and empty tuple elements" {
    let left = [([1, 2], (3, 4)), ([5, 6], (7, 8))]
    let right = [([2, 3], (4, 5)), ([6, 7], (8, 9))]
    let empty = [(), ()]

    assert((left + right) == [([3, 5], (7, 9)), ([11, 13], (15, 17))])
    assert((left + 1) == [([2, 3], (4, 5)), ([6, 7], (8, 9))])
    assert((-left) == [([-1, -2], (-3, -4)), ([-5, -6], (-7, -8))])
    assert((empty + empty) == empty)
    assert((empty + 1) == empty)
    assert((-empty) == empty)
}
