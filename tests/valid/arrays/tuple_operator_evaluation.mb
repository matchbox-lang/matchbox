var calls = 0

func values() -> (i32, i32)[2] {
    calls += 1

    return [(calls, calls), (calls, calls)]
}

func scalar() -> i32 {
    calls += 1

    return calls
}

test "tuple evaluation" {
    let right_broadcast = values() - scalar()
    let left_broadcast = scalar() - values()

    assert(right_broadcast == [(-1, -1), (-1, -1)])
    assert(left_broadcast == [(-1, -1), (-1, -1)])
    assert(calls == 4)
}
