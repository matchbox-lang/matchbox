let small: i16[2] = [-32768, 32767]
let bytes: u8[2] = [0, 255]
let shorts: u16[2] = [0, 65535]
let words: u32[2] = [0, 4294967295]
let wide: i64[2] = [5000000000, -6000000000]
let huge: u64[2] = [0, 18446744073709551615]
let singles: f32[2] = [1.5, -2.5]
let doubles: f64[2] = [1.5, -2.5]

assert((-small) == [-32768, -32767])
assert((~bytes) == u8[2](255) - bytes)
assert((~shorts) == u16[2](65535) - shorts)
assert((~words) == u32[2](4294967295) - words)
assert((-wide) == [-5000000000, 6000000000])
assert((~huge) == u64[2](18446744073709551615) - huge)
assert((-singles) == [-1.5, 2.5])
assert((-doubles) == [-1.5, 2.5])
