let value = 1000

func select(choose: bool, value: i32) -> i32 {
    let local = value + 1
    
    let result = if choose {
        value
    } else {
        local
    }

    return result
}

let selectedThen = select(true, 10)
let selectedElse = select(false, 20)

print(selectedThen)
print(selectedElse)
print(value)
