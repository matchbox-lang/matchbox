func update(choose: bool, value: i32) -> i32 {
    var result = value

    if choose {
        result += 2
    } else {
        result -= 3
    }

    return result
}

test "branch enclosing assignment" {
    let updated_then = update(true, 30)
    let updated_else = update(false, 40)

    assert(updated_then == 32)
    assert(updated_else == 37)
}
