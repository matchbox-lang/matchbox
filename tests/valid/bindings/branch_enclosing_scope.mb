let value = 1000

func select(choose: bool, value: i32) -> i32 {
    let local = value + 1
    
    let result = if choose {
        value
    } else {
        local
    }

    return result
}

let selected_then = select(true, 10)
let selected_else = select(false, 20)

print(selected_then)
print(selected_else)
print(value)
