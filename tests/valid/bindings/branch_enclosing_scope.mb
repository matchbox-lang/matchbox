func select(choose: bool, value: i32) -> i32 {
    let local = value + 1

    let result = if choose {
        value
    } else {
        local
    }

    return result
}

test "branch enclosing scope" {
    let value = 1000
    let selected_then = select(true, 10)
    let selected_else = select(false, 20)

    assert(selected_then == 10)
    assert(selected_else == 21)
    assert(value == 1000)
}
