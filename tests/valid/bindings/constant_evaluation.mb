const BASE = 10

func square(x) {
    return x * x
}

const CONSTANT_RESULT = square(BASE)
let result = const square(10)

assert(CONSTANT_RESULT == 100)
assert(result == 100)

func local(x) {
    const OFFSET = square(2)
    return x + OFFSET
}

let first = local(3)
let second = local(5)

assert(first == 7)
assert(second == 9)

const square(3)
