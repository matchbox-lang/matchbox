func square(x) {
    return x * x
}

func local(x) {
    const OFFSET = square(2)
    return x + OFFSET
}

test "discarded constant expression" {
    const square(3)
}

test "constant expression evaluation" {
    const BASE = 10
    const CONSTANT_RESULT = square(BASE)
    let result = const square(10)

    assert(CONSTANT_RESULT == 100)
    assert(result == 100)
}

test "local constants in function calls" {
    let first = local(3)
    let second = local(5)

    assert(first == 7)
    assert(second == 9)
}
