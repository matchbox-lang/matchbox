func factorial(n) {
    if n <= 1 {
        return 1
    }

    return n * factorial(n - 1)
}

func sum(n) {
    var result = 0
    var i = 0

    while i < n {
        result += i
        i += 1
    }

    return result
}

const FACTORIAL_RESULT = factorial(5)
const SUM_RESULT = sum(5)

assert(FACTORIAL_RESULT == 120)
assert(SUM_RESULT == 10)

let runtime_result = factorial(6)

assert(runtime_result == 720)
