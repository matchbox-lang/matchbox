test "integer constant values and copies" {
    const WIDE: u64 = 18446744073709551615
    const NEGATIVE: i64 = -9223372036854775808
    const COPY = WIDE
    const WIDENED: i64 = 10

    assert(WIDE == COPY)
    assert(NEGATIVE < 0)
    assert(WIDENED == 10)

    const SMALL_NEGATIVE = -10
    const LARGE_INTEGER = 65535

    assert(SMALL_NEGATIVE == -10)
    assert(LARGE_INTEGER == 65535)
}

test "float constant values" {
    const FLOATING: f32 = 1.25

    assert(FLOATING == 1.25)
}

test "string constant values" {
    const TEXT = string(123)

    assert(TEXT == "123")
}

test "char and bool constants" {
    const CHARACTER = 'a'
    const TRUTH = true

    assert(CHARACTER == 'a')
    assert(TRUTH)
}
