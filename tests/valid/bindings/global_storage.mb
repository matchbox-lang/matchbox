var first = 10
var second = 20

func update() {
    first = second + 3
}

var wide: i64 = 4294967296

func update_wide() {
    wide += first
}

test "global storage" {
    assert((second + first) == 30)

    update()
    assert(first == 23)

    update_wide()
    assert(wide == 4294967319)

    first += 1

    assert(first == 24)

    if first != 24 {
        exit(1)
    }

    wide += 1

    assert(wide == 4294967320)

    if wide != 4294967320 {
        exit(1)
    }
}
