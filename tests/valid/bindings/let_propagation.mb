let x = 10
let y = 20
let sum = x + y
let chained = sum * 2

print(sum)
print(chained)
print(y / x)
print(y % x)
print(x & y)
print(x | y)
print(x ^ y)

func local_constants() {
    let x = 3
    let alias = x
    let result = alias + 4

    print(result)

    if true {
        let x = 50
        print(x + 1)
    }

    print(x)
}

local_constants()
print(x)

var changing = 4
let snapshot = changing
changing = 9

print(snapshot)
print(changing)

func source() {
    print(100)
    return 5
}

let dynamic = source()

print(dynamic + x)
