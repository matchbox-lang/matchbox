var observed_steps = 0

func local_constants() {
    let x = 3
    let alias = x
    let result = alias + 4

    assert(result == 7)

    if true {
        let x = 50

        assert((x + 1) == 51)
    }

    assert(x == 3)
}

func source() {
    observed_steps += 1
    return 5
}

test "fixed binding arithmetic" {
    let x = 10
    let y = 20
    let sum = x + y
    let chained = sum * 2

    assert(sum == 30)
    assert(chained == 60)
    assert((y / x) == 2)
    assert((y % x) == 0)
    assert((x & y) == 0)
    assert((x | y) == 30)
    assert((x ^ y) == 30)

    assert(observed_steps == 0)
}

test "local fixed binding scope" {
    let x = 10

    local_constants()
    assert(x == 10)

    assert(observed_steps == 0)
}

test "fixed mutable snapshots" {
    var changing = 4
    let snapshot = changing
    changing = 9

    assert(snapshot == 4)
    assert(changing == 9)

    assert(observed_steps == 0)
}

test "fixed arithmetic with runtime values" {
    let x = 10
    let dynamic = source()

    assert((dynamic + x) == 15)

    assert(observed_steps == 1)
}
