func shared(value: &i32, expected: i32) {
    assert(value == expected)
}

func exclusive(value: ^i32, expected: i32) {
    assert(value == expected)
}

func return_shared(value: &i32) -> &i32 {
    return value
}

let global_value = 15

func read_global() {
    assert(global_value == 15)
}

test "local fixed binding references" {
    let explicit_shared = 11
    let explicit_exclusive = 12
    let implicit_shared = 13
    let implicit_exclusive = 14

    shared(&explicit_shared, 11)
    exclusive(^explicit_exclusive, 12)
    shared(implicit_shared, 13)
    exclusive(implicit_exclusive, 14)

    assert(explicit_shared == 11)
    assert(explicit_exclusive == 12)
    assert(implicit_shared == 13)
    assert(implicit_exclusive == 14)

    let reference = return_shared(&explicit_shared)

    assert(reference == 11)
}

test "global fixed binding references" {
    read_global()
    exclusive(global_value, 15)
    read_global()
}
