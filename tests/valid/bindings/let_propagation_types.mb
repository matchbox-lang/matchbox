test "fixed integer binding widths" {
    let small: i8 = 100
    let small_copy: i8 = small
    let wider: i64 = small_copy

    assert(small_copy == 100)
    assert(wider == 100)

    let unsigned: u32 = 4294967295
    let unsigned_copy = unsigned

    assert(unsigned_copy == 4294967295)

    let wide: i64 = 4294967296
    let wide_copy = wide

    assert(wide_copy == 4294967296)
}

test "fixed floating point bindings" {
    let floating: f32 = 10
    let floating_copy = floating

    assert(floating_copy == 10.0)
}

test "fixed integer arithmetic results" {
    let wrapped = 2147483647 + 1
    let wrapped_copy = wrapped

    assert(wrapped_copy == -2147483648)

    let negative = 0 - 10

    assert((negative / 2) == -5)
}

test "fixed string and character bindings" {
    let name = "Alice"
    let name_copy = name
    let punctuation = '!'

    print(name)
    print(name_copy + punctuation)
}
