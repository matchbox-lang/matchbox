let global = 20

func test_local(value: i32) {
    assert(value == 100)
    assert(global == 20)

    let local = 200

    assert(local == 200)

    func inner(value: i32) {
        assert(value == 300)
        assert(global == 20)
    }

    inner(300)
    assert(value == 100)
    assert(local == 200)
}

test "local scope" {
    test_local(100)
}
