func select(choose: bool, value: i32) -> i32 {
    let local = value + 4

    let result = match choose {
        case true: value
        case _: local
    }

    return result
}

test "match enclosing scope" {
    let selected_then = select(true, 60)
    let selected_else = select(false, 70)

    assert(selected_then == 60)
    assert(selected_else == 74)
}
