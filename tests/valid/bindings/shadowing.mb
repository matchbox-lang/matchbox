var value = 10

func test_shadowing() {
    assert(value == 10)

    var value = 400

    assert(value == 400)

    value = 450

    assert(value == 450)

    func inner() {
        assert(value == 10)

        value = 25

        assert(value == 25)
    }

    inner()
    assert(value == 450)
}

test "shadowing" {
    test_shadowing()
    assert(value == 25)
}
