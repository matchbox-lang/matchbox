type Integer = i32
type Text = string
type View[T] = &T[]
type TextView = &Text

func sum(values: View[Integer]) -> Integer {
    return values[0] + values[1]
}

test "aliases in array and reference annotations" {
    const COUNT = 2
    
    let values: Integer[COUNT + 1] = [4, 5, 6]
    let inferred: Integer[] = [7, 8]
    let view: View[Integer] = &values
    let text = "hello"
    let text_view: TextView = &text

    let total = sum(view)
    let length = len(text_view)

    assert(total == 9)
    assert(inferred[1] == 8)
    assert(length == 5)
}
