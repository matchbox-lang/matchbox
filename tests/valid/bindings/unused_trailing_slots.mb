var observed_steps = 0
var live = 7

func read_live() {
    assert(live == 7)
}

func side_effect() {
    observed_steps += 1
    return 90
}

test "unused trailing slots" {
    let unused = 10
    let unused_wide: i64 = 4294967296

    if live == 7 {
        var local = 40

        assert(local == 40)
    } else {
        var local = 50

        assert(false)
    }

    assert(live == 7)
    read_live()

    let unused_call = side_effect()
    let folded = 1 + 2

    assert(folded == 3)
    assert(live == 7)

    assert(observed_steps == 1)
}
