test "conditional statement branches" {
    const SCORE = 85
    var grade = ""

    if SCORE >= 90 {
        grade = "A"
    } else if SCORE >= 80 {
        grade = "B"
    } else if SCORE >= 70 {
        grade = "C"
    } else {
        grade = "F"
    }

    assert(grade == "B")
}

test "conditional expression branches" {
    const SCORE = 85

    let grade = if (SCORE >= 90)
        "A"
    else if (SCORE >= 80)
        "B"
    else if (SCORE >= 70)
        "C"
    else
        "F"

    assert(grade == "B")
}

test "nested conditional statements" {
    let x = 10
    let y = 20
    var reached = false

    if x < y {
        if y < 100 {
            reached = true
        }
    }

    assert(reached)
}
