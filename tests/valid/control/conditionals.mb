test "conditional statement branches" {
    const SCORE = 85

    if SCORE >= 90 {
        print("A")
    } else if SCORE >= 80 {
        print("B")
    } else if SCORE >= 70 {
        print("C")
    } else {
        print("F")
    }
}

test "conditional expression branches" {
    const SCORE = 85

    let grade = if (SCORE >= 90)
        "A"
    else if (SCORE >= 80)
        "B"
    else if (SCORE >= 70)
        "C"
    else
        "F"

    print(grade)
}

test "nested conditional statements" {
    let x = 10
    let y = 20
    var reached = false

    if x < y {
        if y < 100 {
            reached = true
        }
    }

    assert(reached)
}
