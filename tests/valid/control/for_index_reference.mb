func increment(index: ^usize) {
    index += 1
}

var count: usize = 0
let bytes: u8[3] = [10, 20, 30]

for index, value in bytes {
    assert(index == count and value == bytes[count])
    count += 1
    increment(^index)
    continue
}

assert(count == 3)

count = 0

for index, value in [10, 20, 30] {
    assert(index == count and value == 10 + i32(count) * 10)
    count += 1
    increment(^index)
}

assert(count == 3)

count = 0
let rows: i32[3][0] = [[], [], []]

for index, row in rows {
    assert(index == count and len(row) == 0)
    count += 1
    increment(^index)
}

assert(count == 3)
