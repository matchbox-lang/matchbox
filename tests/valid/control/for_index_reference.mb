func increment(index: ^usize) {
    index += 1
}

test "array iteration index references" {
    var count: usize = 0
    let bytes: u8[3] = [10, 20, 30]

    for index, value in bytes {
        assert(index == count)
        assert(value == bytes[count])

        count += 1

        increment(^index)
        continue
    }

    assert(count == 3)

    count = 0
}

test "literal iteration index references" {
    var count: usize = 0

    for index, value in [10, 20, 30] {
        assert(index == count)
        assert(value == 10 + i32(count) * 10)

        count += 1

        increment(^index)
    }

    assert(count == 3)

    count = 0
}

test "empty row iteration index references" {
    var count: usize = 0
    let rows: i32[3][0] = [[], [], []]

    for index, row in rows {
        assert(index == count)
        assert(len(row) == 0)

        count += 1

        increment(^index)
    }

    assert(count == 3)
}
