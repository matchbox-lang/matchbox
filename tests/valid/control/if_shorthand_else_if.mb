func choose(first: bool, second: bool) -> i32 {
    var result = 0

    if first { result = 1 } else if (second) result = 2

    return result
}

test "shorthand else if selection" {
    var observed_steps = 0

    if false { assert(false) } else if (true) observed_steps += 1

    let first = choose(true, true)
    let second = choose(false, true)
    let neither = choose(false, false)

    if (first != 1 or second != 2 or neither != 0) exit(1)

    assert(observed_steps == 1)
}

test "mixed shorthand else branches" {
    var selected = 0

    if false { exit(1) } else if false { exit(1) } else if (true) selected = 3

    if (selected != 3) exit(1)

    if selected == 0 {
        exit(1)
    } else if (selected == 3)
        selected = 4
    else {
        exit(1)
    }

    if (selected != 4)
        exit(1)
    else
        selected = 5

    if (selected != 5) exit(1)
}
