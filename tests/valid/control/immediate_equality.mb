func check(value, expected: bool[4]) {
    assert((value == -128) == (expected[0]))
    assert((-128 != value) == (not expected[0]))
    assert((value == 127) == (expected[1]))
    assert((127 != value) == (not expected[1]))
    assert((value == -129) == (expected[2]))
    assert((value != 128) == (expected[3]))
}

test "immediate equality" {
    check(-128, [true, false, false, true])
    check(127, [false, true, false, true])
    check(-129, [false, false, true, true])
    check(128, [false, false, false, false])
}
