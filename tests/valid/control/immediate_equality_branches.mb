func check(value, expected_first: i32, expected_second: i32) {
    var first = 0
    var second = 0

    if value == -128 {
        first = 10
    } else {
        first = 20
    }

    if 127 != value {
        second = 30
    } else {
        second = 40
    }

    assert(first == expected_first)
    assert(second == expected_second)
}

test "immediate equality branches" {
    check(-128, 10, 30)
    check(127, 20, 40)
    check(0, 20, 30)
}
