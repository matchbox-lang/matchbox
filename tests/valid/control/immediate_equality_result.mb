func check(value, expected_equal: bool) {
    let equal = value == 2
    let unequal = value != 2

    if equal {
        assert(expected_equal)
    }

    if unequal {
        assert(not expected_equal)
    }

    assert(equal == expected_equal)
    assert(unequal == not expected_equal)
}

test "immediate equality result" {
    check(2, true)
    check(3, false)
}
