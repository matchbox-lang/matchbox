func checkJoin(value: bool) {
    let conditional = if value {
        10
    } else {
        20
    }
    
    let afterConditional = match true {
        case true:
            30
        case false:
            40
    }

    let matched = match value {
        case true:
            50
        case false:
            60
    }

    let afterMatch = match true {
        case true:
            70
        case false:
            80
    }

    print(conditional)
    print(afterConditional)
    print(matched)
    print(afterMatch)
}

let minimum = match true {
    case true:
        -128
    case false:
        0
}

let zero = match true {
    case true:
        0
    case false:
        1
}

let maximum = match true {
    case true:
        127
    case false:
        0
}

let belowMinimum = match true {
    case true:
        -129
    case false:
        0
}

let aboveMaximum = match true {
    case true:
        128
    case false:
        0
}

print(minimum)
print(zero)
print(maximum)
print(belowMinimum)
print(aboveMaximum)

var globalFirst = 90
var globalSecond = 100

func checkGlobals() {
    let first = match true {
        case true:
            globalFirst
        case false:
            0
    }

    let second = match true {
        case true:
            globalSecond
        case false:
            0
    }

    let immediate = match true {
        case true:
            110
        case false:
            0
    }

    let third = match true {
        case true:
            globalFirst
        case false:
            0
    }

    print(first)
    print(second)
    print(immediate)
    print(third)
}

checkJoin(true)
checkJoin(false)
checkGlobals()
