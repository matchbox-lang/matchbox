test "match statement alternatives" {
    var observed_steps = 0
    let value = 2

    match value {
        case 1:
            assert(false)
        case 2 | 3 | 4:
            observed_steps += 1
        case _:
            assert(false)
    }

    assert(observed_steps == 1)
}

test "subjectless match conditions" {
    var observed_steps = 0
    let value = 2

    match {
        case value < 2 or value == 10:
            assert(false)
        case value == 2:
            observed_steps += 1
    }

    assert(observed_steps == 1)
}

test "match expression alternatives" {
    let value = 2

    let result = match value {
        case 0: 100
        case 1: 200
        case 2 | 3 | 4: 300
        case _: 400
    }

    assert(result == 300)
}

test "subjectless match expression values" {
    let binary_result = match {
        case true: 1
        case false: 0
    }

    assert(binary_result == 1)
}
