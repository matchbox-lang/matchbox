func check(value, expected: i32) {
    var selected = 0

    match value {
        case -128 | 0 | 127:
            selected = 10
        case -129 | 128 | 1000:
            selected = 20
        case _:
            selected = 30
    }

    assert(selected == expected)
}

test "match dynamic alternative boundaries" {
    check(-128, 10)
    check(0, 10)
    check(127, 10)
    check(-129, 20)
    check(128, 20)
    check(1000, 20)
    check(1, 30)
}
