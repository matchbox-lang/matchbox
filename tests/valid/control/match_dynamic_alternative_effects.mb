var pattern_calls = 0

func pattern() {
    pattern_calls += 1
    return 3
}

func check(value, expected: i32) {
    var selected = 0

    match value {
        case 1 | 2 | pattern():
            selected = 10
        case _:
            selected = 20
    }

    assert(selected == expected)
}

test "match dynamic alternative effects" {
    check(1, 10)
    check(2, 10)
    check(3, 10)
    check(4, 20)

    assert(pattern_calls == 4)
}
