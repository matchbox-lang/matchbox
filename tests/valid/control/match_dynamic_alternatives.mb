func check(value, expected: i32) {
    let result = match value {
        case 0: 10
        case 2 | 3 | 4: 20
        case 4 | 5: 30
        case _: 40
    }

    assert(result == expected)
}

test "match dynamic alternatives" {
    check(0, 10)
    check(2, 20)
    check(3, 20)
    check(4, 20)
    check(5, 30)
    check(9, 40)
}
