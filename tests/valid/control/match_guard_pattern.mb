var observed_steps = 0

func guard() -> bool {
    observed_steps += 1
    return true
}

test "match guard pattern" {
    match 10 {
        case 0 if guard():
            assert(false)
        case 5 | 10 if guard():
            observed_steps += 1
        case _:
            assert(false)
    }

    assert(observed_steps == 2)
}
