test "match guard subjectless" {
    var observed_steps = 0
    var checked = false

    match {
        case false if true:
            assert(false)
        case true if checked:
            assert(false)
        case true if not checked:
            observed_steps += 1
        case _:
            assert(false)
    }

    match {
        case _ if checked:
            assert(false)
        case _:
            assert(not checked)
    }

    assert(observed_steps == 1)
}
