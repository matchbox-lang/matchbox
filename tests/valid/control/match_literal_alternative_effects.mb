var pattern_calls: usize = 0
let expected_patterns = [3, 2]

func pattern(value) {
    assert(value == expected_patterns[pattern_calls])

    pattern_calls += 1
    return value
}

test "match literal alternative effects" {
    var observed_steps = 0

    match 2 {
        case 1 | 2 | pattern(3):
            observed_steps += 1
        case _:
            assert(false)
    }

    assert(pattern_calls == 1)

    match 2 {
        case (pattern(2)) | 3:
            observed_steps += 1
        case 2 | 3:
            assert(false)
    }

    assert(pattern_calls == 2)

    assert(observed_steps == 2)
}
