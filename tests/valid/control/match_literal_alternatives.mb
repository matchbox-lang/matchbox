test "match literal alternatives" {
    var observed_steps = 0

    match 2 {
        case 1:
            assert(false)
        case 2 | 3 | 4:
            observed_steps += 1
        case _:
            assert(false)
    }

    match 3 {
        case 2 | 3 | 4:
            observed_steps += 1
        case _:
            assert(false)
    }

    match 4 {
        case 2 | 3 | 4:
            observed_steps += 1
        case 4:
            assert(false)
        case _:
            assert(false)
    }

    assert(observed_steps == 3)
}
