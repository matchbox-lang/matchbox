func check_join(value: bool, expected_conditional: i32, expected_matched: i32) {
    let conditional = if value {
        10
    } else {
        20
    }

    let after_conditional = match true {
        case true:
            30
        case false:
            40
    }

    let matched = match value {
        case true:
            50
        case false:
            60
    }

    let after_match = match true {
        case true:
            70
        case false:
            80
    }

    assert(conditional == expected_conditional)
    assert(after_conditional == 30)
    assert(matched == expected_matched)
    assert(after_match == 70)
}

var global_first = 90
var global_second = 100

func check_globals() {
    let first = match true {
        case true:
            global_first
        case false:
            0
    }

    let second = match true {
        case true:
            global_second
        case false:
            0
    }

    let immediate = match true {
        case true:
            110
        case false:
            0
    }

    let third = match true {
        case true:
            global_first
        case false:
            0
    }

    assert(first == 90)
    assert(second == 100)
    assert(immediate == 110)
    assert(third == 90)
}

test "match narrow integer literal values" {
    let minimum = match true {
        case true:
            -128
        case false:
            0
    }

    let zero = match true {
        case true:
            0
        case false:
            1
    }

    let maximum = match true {
        case true:
            127
        case false:
            0
    }

    assert(minimum == -128)
    assert(zero == 0)
    assert(maximum == 127)
}

test "match integer literals beyond narrow boundaries" {
    let below_minimum = match true {
        case true:
            -129
        case false:
            0
    }

    let above_maximum = match true {
        case true:
            128
        case false:
            0
    }

    assert(below_minimum == -129)
    assert(above_maximum == 128)
}

test "match values after control flow joins" {
    check_join(true, 10, 50)
    check_join(false, 20, 60)
}

test "match global binding values" {
    check_globals()
}
