func check_join(value: bool) {
    let conditional = if value {
        10
    } else {
        20
    }
    
    let after_conditional = match true {
        case true:
            30
        case false:
            40
    }

    let matched = match value {
        case true:
            50
        case false:
            60
    }

    let after_match = match true {
        case true:
            70
        case false:
            80
    }

    print(conditional)
    print(after_conditional)
    print(matched)
    print(after_match)
}

let minimum = match true {
    case true:
        -128
    case false:
        0
}

let zero = match true {
    case true:
        0
    case false:
        1
}

let maximum = match true {
    case true:
        127
    case false:
        0
}

let below_minimum = match true {
    case true:
        -129
    case false:
        0
}

let above_maximum = match true {
    case true:
        128
    case false:
        0
}

print(minimum)
print(zero)
print(maximum)
print(below_minimum)
print(above_maximum)

var global_first = 90
var global_second = 100

func check_globals() {
    let first = match true {
        case true:
            global_first
        case false:
            0
    }

    let second = match true {
        case true:
            global_second
        case false:
            0
    }

    let immediate = match true {
        case true:
            110
        case false:
            0
    }

    let third = match true {
        case true:
            global_first
        case false:
            0
    }

    print(first)
    print(second)
    print(immediate)
    print(third)
}

check_join(true)
check_join(false)
check_globals()
