test "match statements" {
    var observed_steps = 0
    let value = 2

    match value {
        case captured:
            assert(captured == 2)
    }

    match value {
        case 1:
            assert(false)
        case 2:
            observed_steps += 1
    }

    match value {
        case 1:
            assert(false)
        case _:
            observed_steps += 1
    }

    match {
        case value < 2:
            assert(false)
        case value == 2:
            observed_steps += 1
    }

    assert(observed_steps == 3)
}
