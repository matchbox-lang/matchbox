func check_zero(value, expected: i32) {
    let result = match value {
        case 0: 10
        case 1: 20
        case _: 30
    }

    assert(result == expected)
}

func check_false(value: bool, expected: i32) {
    var selected = 0

    match value {
        case false: selected = 40
        case _: selected = 50
    }

    assert(selected == expected)
}

test "match zero branch" {
    check_zero(0, 10)
    check_zero(1, 20)
    check_zero(2, 30)
    check_zero(-1, 30)
    check_zero(256, 30)

    check_false(false, 40)
    check_false(true, 50)
}
