func square(n: i32) -> i32 {
    return n * n
}

var count = 0

test "square" {
    let result = square(5)

    assert(result == 25)
}

test "fresh globals" {
    assert(count == 0)

    count = 7
}

test {
    const EXPECTED = 4
    let result = 2 + 2

    assert(result == EXPECTED)
    assert(count == 0)
}

test skip "skip failure" {
    assert(false)
}

test skip {
    exit(1)
}
