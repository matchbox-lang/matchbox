test "while branches" {
    var count = 0
    var iterations = 0
    var middle_count = 0

    while count < 5 {
        if count == 1 {
            middle_count += 1
        } else {
            assert(count == iterations)
        }

        iterations += 1
        count += 1
    }

    assert(count == 5)
    assert(iterations == 5)
    assert(middle_count == 1)
}
