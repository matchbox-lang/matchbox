func sum() {
    var count = 0
    var total = 0

    while count != 3 {
        let value: i64 = 10000000000
        total += count

        assert(value == 10000000000)

        count += 1
    }

    let after = 7

    return total + after
}

test "while local slots" {
    let result = sum()

    assert(result == 10)
}
