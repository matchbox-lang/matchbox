func unused_leaf() -> i32 {
    return 1
}

func unused_caller() -> i32 {
    return unused_leaf()
}

func used() -> i32 {
    return 2
}

func outer() -> i32 {
    func unused_nested() -> i32 {
        return 3
    }

    func used_nested() -> i32 {
        return 4
    }

    return used_nested()
}

test "dead functions" {
    let used_result = used()

    assert(used_result == 2)

    let outer_result = outer()

    assert(outer_result == 4)
}
