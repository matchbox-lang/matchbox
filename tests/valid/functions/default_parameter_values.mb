func values(wide: u64 = 18446744073709551615, negative: i64 = -9223372036854775808,
    floating: f64 = 1.25, text: string = "hello", character: char = 'a', truth: bool = true) {
    assert(wide == 18446744073709551615)
    assert(negative == -9223372036854775808)
    assert(floating == 1.25)
    print(text)
    assert(character == 'a')
    assert(truth)
}

values()

func widened(n: i64 = i32(10)) = n
func small(n: u8 = 255) = n
func single(n: f32 = 1.5) = n

let wide = widened()
let narrow = small()
let floating = single()

assert(wide == 10)
assert(narrow == 255)
assert(floating == 1.5)
