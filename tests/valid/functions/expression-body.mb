func neg(n) = -n
func typedNeg(n: i32) -> i32 = -n
func blockNeg(n: i32) -> i32 {
    return -n
}

let inferred = neg(5)
let typed = typedNeg(5)
let block = blockNeg(5)

if (inferred != -5) exit(1)
if (typed != -5) exit(1)
if (block != -5) exit(1)

func factorial(n: i32) -> i32 = n <= 1 ? 1 : n * factorial(n - 1)

let recursive = factorial(5)

if recursive != 120 {
    exit(1)
}

func outer(n) {
    func square(value) = value * value
    return square(n)
}

let nested = outer(4)

if nested != 16 {
    exit(1)
}

func constant() = 42; let value = constant()

if value != 42 {
    exit(1)
}
