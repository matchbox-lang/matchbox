func neg(n) = -n
func typed_neg(n: i32) -> i32 = -n

func block_neg(n: i32) -> i32 {
    return -n
}

func factorial(n: i32) -> i32 = if n <= 1 {
    1
} else {
    n * factorial(n - 1)
}

func outer(n) {
    func square(value) = value * value
    return square(n)
}

test "expression body return inference" {
    let inferred = neg(5)
    let typed = typed_neg(5)
    let block = block_neg(5)

    if (inferred != -5) exit(1)
    if (typed != -5) exit(1)
    if (block != -5) exit(1)
}

test "recursive expression bodies" {
    let recursive = factorial(5)

    if recursive != 120 {
        exit(1)
    }
}

test "nested expression body functions" {
    let nested = outer(4)

    if nested != 16 {
        exit(1)
    }
}

test "expression body semicolon boundaries" {
    func constant() = 42; let value = constant()

    if value != 42 {
        exit(1)
    }
}
