func defaults(value: i32 = 7) {
    return value
}

func defaults(value: string) {
    return value
}

func variadic(...values: i32) {
    return len(values)
}

func variadic(value: string) {
    return value
}

func array(value: i32[2]) {
    return value[0]
}

func array(value: i32[3]) {
    return value[2]
}

func bytes(value: u8[2]) {
    return value[0]
}

func bytes(value: string) {
    return 0
}

func view(value: &string) {
    return len(value)
}

func view(value: i32) {
    return value
}

func access(value: &i32) {
    return 1
}

func access(value: ^i32) {
    return 2
}

test "overload defaults and parameter kinds" {
    let default_value = defaults()
    let many = variadic(1, 2, 3)
    let first = array([5, 6])
    let last = array([1, 2, 9])
    let length = view("hello")
    let byte = bytes([7, 8])
    var value = 4
    let shared = access(&value)
    let exclusive = access(^value)

    assert(default_value == 7)
    assert(many == 3)
    assert(first == 5)
    assert(last == 9)
    assert(length == 5)
    assert(byte == 7)
    assert(shared == 1)
    assert(exclusive == 2)
}
