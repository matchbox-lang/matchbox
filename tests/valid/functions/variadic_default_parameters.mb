func offset(base: i32 = 10, ...numbers: i32) -> i32 {
    var total = base

    for n in numbers {
        total += n
    }

    return total
}

test "defaults before variadics" {
    let default_value = offset()
    let fixed = offset(5)
    let many = offset(5, 1, 2)

    assert(default_value == 10)
    assert(fixed == 5)
    assert(many == 8)
}
