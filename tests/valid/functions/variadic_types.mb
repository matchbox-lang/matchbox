func bytes(...values: u8) -> u8 {
    return values[0] + values[1] + values[2]
}

func wide(...values: f64) -> f64 {
    return values[0] + values[1]
}

func words(...values: string) -> string {
    return values[0] + values[1]
}

test "packed elements, widening and strings" {
    let small: u8 = 2
    let narrow: f32 = 1.5
    let byte_sum = bytes(1, small, 3)
    let float_sum = wide(narrow, 2.5)
    let text = words("hello", " world")

    assert(byte_sum == 6 and float_sum == 4.0 and text == "hello world")
}
