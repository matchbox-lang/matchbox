func check_wide_immediates(value: i64, bits: u64) {
    if value + -128 != -126 {
        exit(1)
    }

    if value - -128 != 130 {
        exit(1)
    }

    if value * 127 != 254 {
        exit(1)
    }

    if (bits & 255) != 2 {
        exit(1)
    }

    if (bits | 128) != 130 {
        exit(1)
    }

    if (bits ^ 255) != 253 {
        exit(1)
    }

    if (bits << 32) != 8589934592 {
        exit(1)
    }

    if (bits >> 1) != 1 {
        exit(1)
    }

    if (value >> 1) != 1 {
        exit(1)
    }
}

test "narrow integer compound assignment" {
    var value8: i8 = 2
    value8 = 2
    value8 = 2
    value8 += 3

    assert(value8 == 5)

    value8 = 2
    value8 -= -128

    assert(value8 == -126)

    value8 = 2
    value8 *= 127

    assert(value8 == -2)

    value8 = 2
    value8 |= -1

    assert(value8 == -1)

    value8 = 2
    value8 <<= 1

    assert(value8 == 4)
}

test "short integer compound assignment" {
    var value16: i16 = 2
    value16 = 2
    value16 += 3

    assert(value16 == 5)

    value16 = 2
    value16 -= -128

    assert(value16 == 130)

    value16 = 2
    value16 *= 127

    assert(value16 == 254)

    value16 = 2
    value16 |= -1

    assert(value16 == -1)

    value16 = 2
    value16 <<= 1

    assert(value16 == 4)
}

test "integer compound arithmetic" {
    var value32: i32 = 2
    value32 = 2
    value32 += 3

    assert(value32 == 5)

    value32 = 2
    value32 -= 3

    assert(value32 == -1)

    value32 = 2
    value32 *= 3

    assert(value32 == 6)

    value32 = 2
    value32 /= 3

    assert(value32 == 0)

    value32 = 2
    value32 %= 3

    assert(value32 == 2)
}

test "integer compound bitwise ops" {
    var value32: i32 = 2

    value32 &= 3

    assert(value32 == 2)

    value32 = 2
    value32 |= 3

    assert(value32 == 3)

    value32 = 2
    value32 ^= 3

    assert(value32 == 1)

    value32 = 2
    value32 <<= 1

    assert(value32 == 4)

    value32 = 2
    value32 >>= 1

    assert(value32 == 1)
}

test "negative assignment operands" {
    var value32: i32 = 2

    value32 += -128

    assert(value32 == -126)

    value32 = 2
    value32 -= -128

    assert(value32 == 130)

    value32 = 2
    value32 *= -128

    assert(value32 == -256)
}

test "assignment operand bounds" {
    var value32: i32 = 2

    value32 += 127

    assert(value32 == 129)

    value32 = 2
    value32 += 128

    assert(value32 == 130)

    value32 = 2
    value32 += -129

    assert(value32 == -127)

    value32 = 2
    value32 &= 255

    assert(value32 == 2)

    value32 = 2
    value32 |= -1

    assert(value32 == -1)
}

test "wide integer compound assignment" {
    var value64: i64 = 2
    value64 = 2
    value64 += 3

    assert(value64 == 5)

    value64 = 2
    value64 -= -128

    assert(value64 == 130)

    value64 = 2
    value64 *= 127

    assert(value64 == 254)

    value64 = 2
    value64 |= -1

    assert(value64 == -1)

    value64 = 2
    value64 <<= 1

    assert(value64 == 4)
}

test "wide integer arithmetic operands" {
    check_wide_immediates(2, 2)
}
