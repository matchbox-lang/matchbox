func compare(left: f64, right: f64) {
    print(left == right)
    print(left != right)
    print(left < right)
    print(left <= right)
    print(left > right)
    print(left >= right)

    let ordering: i32 = left <=> right
    print(ordering)
}

compare(-1.5, 1.5)
compare(1.5, -1.5)
compare(1.5, 1.5)
