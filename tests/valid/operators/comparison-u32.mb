func compare(left: u32, right: u32) {
    print(left == right)
    print(left != right)
    print(left < right)
    print(left <= right)
    print(left > right)
    print(left >= right)
    
    let ordering: i32 = left <=> right
    print(ordering)
}

compare(0, 4294967295)
compare(4294967295, 0)
compare(4294967295, 4294967295)
