func compare(left: f32, right: f32, expected_order: i32) {
    assert((left == right) == (expected_order == 0))
    assert((left != right) == (expected_order != 0))
    assert((left < right) == (expected_order < 0))
    assert((left <= right) == (expected_order <= 0))
    assert((left > right) == (expected_order > 0))
    assert((left >= right) == (expected_order >= 0))
    assert((left <=> right) == expected_order)
}

test "comparison f32" {
    compare(-1.5, 1.5, -1)
    compare(1.5, -1.5, 1)
    compare(1.5, 1.5, 0)
}
