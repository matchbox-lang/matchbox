func compare(value: f32, expected_equal: bool, expected_order: i32) {
    assert((value == value) == (expected_equal))
    assert((value != value) == (not expected_equal))
    assert(not ((value < 0.0)))
    assert((value <= 0.0) == (expected_equal))
    assert(not ((value > 0.0)))
    assert((value >= 0.0) == (expected_equal))
    assert((value <=> 0.0) == expected_order)
}

test "comparison f32 special" {
    compare(0.0 / 0.0, false, -1)
    compare(-0.0, true, 0)
}
