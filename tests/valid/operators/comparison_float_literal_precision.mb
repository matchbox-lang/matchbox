test "comparison float literal precision" {
    assert((10.0 <=> 10245556888996.5556663) == -1)
    assert((16777217.0 <=> 16777216.0) == 1)
    assert((10245556888996.5556663 > 10245556888996.0))
    assert((1.0e-50 > 0.0))
    assert((-1.0e-50 < 0.0))

    let wide: f64 = 0.1

    assert((0.1 == wide))
}
