func compare(left: i16, right: i16, expected_order: i32) {
    assert((left == right) == (expected_order == 0))
    assert((left != right) == (expected_order != 0))
    assert((left < right) == (expected_order < 0))
    assert((left <= right) == (expected_order <= 0))
    assert((left > right) == (expected_order > 0))
    assert((left >= right) == (expected_order >= 0))
    assert((left <=> right) == expected_order)
}

test "comparison i16" {
    compare(-1, 1, -1)
    compare(1, -1, 1)
    compare(1, 1, 0)
}
