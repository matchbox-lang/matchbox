func compare(left: i32, right: i32, expected_order: i32) {
    assert((left == right) == (expected_order == 0))
    assert((left != right) == (expected_order != 0))
    assert((left < right) == (expected_order < 0))
    assert((left <= right) == (expected_order <= 0))
    assert((left > right) == (expected_order > 0))
    assert((left >= right) == (expected_order >= 0))
    assert((left <=> right) == expected_order)

    var branches = 0

    if left == right {
        branches += 1
    }

    if left != right {
        branches += 1
    }

    if left < right {
        branches += 1
    }

    if left <= right {
        branches += 1
    }

    if left > right {
        branches += 1
    }

    if left >= right {
        branches += 1
    }

    assert(branches == 3)
}

test "comparison i32" {
    compare(-1, 1, -1)
    compare(1, -1, 1)
    compare(1, 1, 0)
}
