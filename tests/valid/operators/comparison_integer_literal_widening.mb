test "comparison literal widening" {
    assert((10 <=> 10245556888996) == -1)
    assert((10245556888996 <=> 10) == 1)
    assert((-10 <=> 10245556888996) == -1)
    assert((10 <=> -10245556888996) == 1)
    assert((-2147483648 <=> 2147483648) == -1)
    assert((2147483648 > 10))
    assert((10 < 2147483648))
    assert((2147483648 != 10))
    assert((16 <=> 1024) == -1)
}
