func signed8(value: i8) {
    assert((value + 1 < 0))
    assert((value + 1 <=> 0) == -1)
}

func unsigned8(value: u8) {
    assert((value + 0 > 0))
    assert((value + 0 == 255))
}

func signed16(value: i16) {
    assert((value + 1 < 0))
    assert((value + 1 <=> 0) == -1)
}

func unsigned16(value: u16) {
    assert((value + 0 > 0))
    assert((value + 0 == 65535))
}

test "comparison narrow overflow" {
    signed8(127)
    unsigned8(255)
    signed16(32767)
    unsigned16(65535)
}
