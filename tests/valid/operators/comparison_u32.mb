func compare(left: u32, right: u32, expected_order: i32) {
    assert((left == right) == (expected_order == 0))
    assert((left != right) == (expected_order != 0))
    assert((left < right) == (expected_order < 0))
    assert((left <= right) == (expected_order <= 0))
    assert((left > right) == (expected_order > 0))
    assert((left >= right) == (expected_order >= 0))
    assert((left <=> right) == expected_order)

    var branches = 0

    if left == right {
        branches += 1
    }

    if left != right {
        branches += 1
    }

    if left < right {
        branches += 1
    }

    if left <= right {
        branches += 1
    }

    if left > right {
        branches += 1
    }

    if left >= right {
        branches += 1
    }

    assert(branches == 3)
}

test "comparison u32" {
    compare(0, 4294967295, -1)
    compare(4294967295, 0, 1)
    compare(4294967295, 4294967295, 0)
}
