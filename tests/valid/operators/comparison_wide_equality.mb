var observed_steps = 0

func compare(left: u64, right: u64) {
    assert(not ((left == right)))
    assert((left != right))

    if left == right {
        assert(false)
    } else {
        observed_steps += 1
    }

    match left {
        case 4294967296:
            observed_steps += 1
        case 0:
            assert(false)
        case _:
            assert(false)
    }
}

test "comparison wide equality" {
    compare(4294967296, 0)

    assert(observed_steps == 2)
}
