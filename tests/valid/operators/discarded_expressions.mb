func effect() -> i32 {
    print(1)

    return 1
}

let divisor = 2

1 + 2
not false
~1

effect() + 1
4 / divisor
4 % divisor
2 ** divisor

func unexpected() -> bool {
    exit(1)

    return true
}

false and unexpected()
true or unexpected()

let unused_and = false and unexpected()
let unused_or = true or unexpected()
let zero = 0

false and (1 / zero == 0)
true or (1 % zero == 0)
