var observed_steps = 0

func effect() -> i32 {
    observed_steps += 1

    return 1
}

func unexpected() -> bool {
    exit(1)

    return true
}

test "discarded expressions" {
    let divisor = 2

    1 + 2
    not false
    ~1

    effect() + 1
    4 / divisor
    4 % divisor
    2 ** divisor

    false and unexpected()
    true or unexpected()

    let unused_and = false and unexpected()
    let unused_or = true or unexpected()
    let zero = 0

    false and (1 / zero == 0)
    true or (1 % zero == 0)

    assert(observed_steps == 1)
}
