let narrow: f32 = 2.5
let wide: f64 = 3.0

let sum: f64 = narrow + wide
let difference: f64 = wide - narrow
let product: f64 = narrow * wide
let quotient: f64 = wide / narrow
let remainder32: f32 = 5.5 % 2.0
let remainder64: f64 = wide % narrow
let literal_product: f64 = narrow * 4

let signed16: i16 = -4
let unsigned16: u16 = 4
let signed32: i32 = -4
let unsigned32: u32 = 4
let signed_product32: f32 = narrow * signed16
let unsigned_product32: f32 = narrow * unsigned16
let signed_product64: f64 = wide * signed32
let unsigned_product64: f64 = wide * unsigned32

let widened: f64 = narrow
var assigned: f64
assigned = narrow
var accumulated: f64 = wide
accumulated += narrow
var scaled: f32 = narrow
scaled *= 2.0

func accept64(value: f64) -> f64 {
    return value
}

func widen_return(value: f32) -> f64 {
    return value
}

print(sum)
print(difference)
print(product)
print(quotient)
print(remainder32)
print(remainder64)
print(literal_product)
print(signed_product32)
print(unsigned_product32)
print(signed_product64)
print(unsigned_product64)
print(widened)
print(assigned)
print(accumulated)
print(scaled)
print(accept64(narrow))
print(widen_return(narrow))

let half_turn = rad(180.0) / 2.0
let degrees = deg(1.0) + 1.0
let complementary_angles = acos(0.5) + asin(0.5)
let full_turn = atan(1.0) * 8.0
let hyperbolic_difference = cosh(1.0) - sinh(1.0)
let doubled_hyperbolic_tangent = tanh(0.5) * 2.0

print(half_turn)
print(degrees)
print(complementary_angles)
print(full_turn)
print(hyperbolic_difference)
print(doubled_hyperbolic_tangent)
