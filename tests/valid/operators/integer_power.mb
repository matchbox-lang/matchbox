var base = 5
var exponent = 2
let result = base ** exponent

assert(result == 25)
base **= exponent
assert(base == 25)
assert(5 ** 2 == 25)
assert((-5) ** 3 == -125)
assert(2 ** -3 == 0)
assert((-1) ** -3 == -1)
assert((-1) ** -2 == 1)
assert(0 ** 0 == 1)
assert(2 ** 31 == -2147483648)
assert(2 ** 32 == 0)

const POWER = 5 ** 2

assert(POWER == 25)
