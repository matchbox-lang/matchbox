test "literal comparison types" {
    let signed8: i8 = -128
    let signed16: i16 = -32768
    let unsigned8: u8 = 255
    let unsigned16: u16 = 65535
    let unsigned32: u32 = 4294967295

    assert((signed8 < 0))
    assert(not ((signed16 >= 0)))
    assert((unsigned8 > 127))
    assert(not ((unsigned16 <= 32767)))
    assert((unsigned32 > 2147483647))
    assert((unsigned32 == 4294967295))
}
