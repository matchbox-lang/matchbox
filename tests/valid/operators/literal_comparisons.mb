test "literal comparisons" {
    let value = 2

    assert((value == 2))
    assert(not ((value != 2)))
    assert(not ((value < 2)))
    assert((value <= 2))
    assert(not ((value > 2)))
    assert((value >= 2))
    assert((-1 < 0))
    assert((2147483647 + 1 < 0))
    assert((-2147483648 == 2147483647 + 1))
}
