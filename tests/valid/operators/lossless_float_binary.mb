func combine(left: f32, right: f64) {
    assert((left + right) == 7.5)
    assert((right + left) == 7.5)
    assert((left - right) == -2.5)
    assert((right - left) == 2.5)
    assert((left * right) == 12.5)
    assert((right * left) == 12.5)
    assert((left / right) == 0.5)
    assert((right / left) == 2.0)
    assert((left < right))
    assert((right > left))
    assert(not ((left == right)))
    assert(not ((right == left)))
    assert((left <=> right) == -1)
    assert((right <=> left) == 1)
}

test "lossless float binary" {
    combine(2.5, 5.0)
}
