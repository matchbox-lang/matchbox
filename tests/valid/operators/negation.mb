func negate8(value: i8) -> i8 {
    return -value
}

func negate16(value: i16) -> i16 {
    return -value
}

func negate32(value: i32) -> i32 {
    return -value
}

func negate64(value: i64) -> i64 {
    return -value
}

func negateFloat32(value: f32) -> f32 {
    return -value
}

func negateFloat64(value: f64) -> f64 {
    return -value
}

print(negate8(4))
print(negate16(4))
print(negate32(4))
print(negate64(4))
print(negateFloat32(1.5))
print(negateFloat64(1.5))
print(negateFloat32(-0.0))
print(negateFloat64(-0.0))
