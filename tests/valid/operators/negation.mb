func negate8(value: i8) -> i8 {
    return -value
}

func negate16(value: i16) -> i16 {
    return -value
}

func negate32(value: i32) -> i32 {
    return -value
}

func negate64(value: i64) -> i64 {
    return -value
}

func negate_float32(value: f32) -> f32 {
    return -value
}

func negate_float64(value: f64) -> f64 {
    return -value
}

test "integer negation" {
    let signed8 = negate8(4)
    let signed16 = negate16(4)
    let signed32 = negate32(4)
    let signed64 = negate64(4)

    assert(signed8 == -4)
    assert(signed16 == -4)
    assert(signed32 == -4)
    assert(signed64 == -4)
}

test "float negation" {
    let float32 = negate_float32(1.5)
    let float64 = negate_float64(1.5)

    assert(float32 == -1.5)
    assert(float64 == -1.5)
}

test "negative zero negation" {
    let zero32 = negate_float32(-0.0)
    let zero64 = negate_float64(-0.0)
    let one64: f64 = 1.0
    let reciprocal32 = 1.0 / zero32
    let reciprocal64 = one64 / zero64

    assert(zero32 == 0.0)
    assert(zero64 == 0.0)
    assert(reciprocal32 == f32.INFINITY)
    assert(reciprocal64 == f64.INFINITY)
}
