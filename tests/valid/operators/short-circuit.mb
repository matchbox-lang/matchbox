var calls = 0

func probe(value: bool) -> bool {
    calls += 1

    return value
}

let skippedAnd = probe(false) and probe(true)
let skippedOr = probe(true) or probe(false)
let requiredAnd = probe(true) and probe(false)
let requiredOr = probe(false) or probe(true)

if skippedAnd or not skippedOr or requiredAnd or not requiredOr {
    exit(1)
}

if calls != 6 {
    exit(1)
}

let chained = probe(false) and probe(true) or probe(true)

if not chained or calls != 8 {
    exit(1)
}

var flag = true
let result = flag and probe(false)

if not flag or result or calls != 9 {
    exit(1)
}

func protected(value: bool) -> bool {
    return value or (1 / 0 == 0)
}

let safe = protected(true)

if not safe {
    exit(1)
}

let falseCondition = 1 == 2
let trueCondition = not falseCondition
let skippedDivision = falseCondition and (1 / (2 - 2) == 0)
let skippedRemainder = trueCondition or (1 % (3 - 3) == 0)

assert(not skippedDivision)
assert(skippedRemainder)
