var calls = 0

func probe(value: bool) -> bool {
    calls += 1

    return value
}

let skipped_and = probe(false) and probe(true)
let skipped_or = probe(true) or probe(false)
let required_and = probe(true) and probe(false)
let required_or = probe(false) or probe(true)

if skipped_and or not skipped_or or required_and or not required_or {
    exit(1)
}

if calls != 6 {
    exit(1)
}

let chained = probe(false) and probe(true) or probe(true)

if not chained or calls != 8 {
    exit(1)
}

var flag = true
let result = flag and probe(false)

if not flag or result or calls != 9 {
    exit(1)
}

func protected(value: bool) -> bool {
    return value or (1 / 0 == 0)
}

let safe = protected(true)

if not safe {
    exit(1)
}

let false_condition = 1 == 2
let true_condition = not false_condition
let skipped_division = false_condition and (1 / (2 - 2) == 0)
let skipped_remainder = true_condition or (1 % (3 - 3) == 0)

assert(not skipped_division)
assert(skipped_remainder)
