func update(value: ^i32, increment: i8) {
    value += increment
    value **= 2
    value >>= 1
}

func update_wide(integer: ^i64, floating: ^f64, increment: i16) {
    integer += increment
    floating *= 2
    integer -= 1
    floating += increment
}

var value = 3
var wide: i64 = 4294967296
var floating: f64 = 1.5

update(^value, 1)
update_wide(^wide, ^floating, 2)

if value != 8 or wide != 4294967297 or floating != 5.0 {
    exit(1)
}

let global_reference = ^value

global_reference += 2

if value != 10 {
    exit(1)
}

func local_reference() {
    var value: usize = 10
    let reference = ^value

    reference += 2
    reference *= 3

    if reference != 36 {
        exit(1)
    }

    value += 1

    if value != 37 {
        exit(1)
    }
}

local_reference()

func rebind() {
    var first = 10
    var second = 20
    var reference = ^first

    reference += 1
    reference = ^second
    reference += 2

    if first != 11 or second != 22 {
        exit(1)
    }
}

rebind()
