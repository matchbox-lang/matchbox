func read(value: &i32) {
    assert(value == 10)
}

func read_exclusive(value: ^i32) {
    assert(value == 20)
}

func return_shared(value: &i32) -> &i32 {
    return value
}

func shared_access() {
    var value = 10
    let first = &value
    let second = &value

    read(first)
    read(second)

    value = 11

    assert(value == 11)
}

func exclusive_access() {
    let value = 20

    read_exclusive(^value)
    assert(value == 20)
}

test "reference access" {
    var value = 30
    let returned = return_shared(&value)

    shared_access()
    exclusive_access()
    assert(returned == 30)
}
