func unrelated() {
    let local = 20
    let reference = &local

    assert(reference == 20)
}

func parameter(reference: i32) {
    assert(reference == 30)
}

test "reference shadowing" {
    var value = 10
    let reference = &value

    assert(reference == 10)

    value += 1

    unrelated()
    parameter(30)

    if value != 11 {
        exit(1)
    }
}
