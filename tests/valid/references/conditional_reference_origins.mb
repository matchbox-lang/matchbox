test "conditional shared reference init" {
    var condition = true
    var left = 10
    var right = 20

    let shared: &i32 = if condition {
        &left
    } else {
        &right
    }

    assert(shared == 10)
}

test "conditional shared reference assignment" {
    var condition = true
    var left = 10
    var right = 20
    var assigned_shared: &i32

    if condition {
        assigned_shared = &left
    } else {
        assigned_shared = &right
    }

    assert(assigned_shared == 10)
}

test "conditional exclusive reference init" {
    var condition = true
    var left = 10
    var right = 20

    let exclusive: ^i32 = if condition {
        ^left
    } else {
        ^right
    }

    assert(exclusive == 10)
}

test "conditional exclusive reference assignment" {
    var condition = true
    var left = 10
    var right = 20
    var assigned_exclusive: ^i32

    if condition {
        assigned_exclusive = ^left
    } else {
        assigned_exclusive = ^right
    }

    assert(assigned_exclusive == 10)
}
