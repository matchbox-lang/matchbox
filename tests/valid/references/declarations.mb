var value = 10
var copied_infer_type = value
var copied: i32 = value
var inferred_shared = &value
var explicit_shared: &i32 = &value
var assigned_shared: &i32

assigned_shared = &value

print(copied_infer_type)
print(copied)
print(inferred_shared)
print(explicit_shared)
print(assigned_shared)

var exclusive_value = 20
var inferred_exclusive = ^exclusive_value
var explicit_exclusive: ^i32 = inferred_exclusive
var assigned_exclusive: ^i32

assigned_exclusive = explicit_exclusive

print(assigned_exclusive)
