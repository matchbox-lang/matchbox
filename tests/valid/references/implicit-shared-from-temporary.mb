func takeShared(n: &i32, extra: i64) {
    assert(extra == 4)

    return n + 1
}

var value = 10
let result = takeShared(value + 1, 4)

assert(result == 12)

func takeWide(n: &i64) {
    assert(true)

    return n + 1
}

let wide: i64 = 4294967296
let wideResult = takeWide(wide + 1)

assert(wideResult == 4294967298)
