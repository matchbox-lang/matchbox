func take_shared(n: &i32, extra: i64) {
    assert(extra == 4)

    return n + 1
}

var value = 10
let result = take_shared(value + 1, 4)

assert(result == 12)

func take_wide(n: &i64) {
    assert(true)

    return n + 1
}

let wide: i64 = 4294967296
let wide_result = take_wide(wide + 1)

assert(wide_result == 4294967298)
