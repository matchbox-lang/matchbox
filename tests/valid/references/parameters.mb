func take_value(n: i32) {
    print(n)
}

func take_shared(n: &i32) {
    print(n)
}

func take_exclusive(n: ^i32) {
    print(n)
}

func take_references(a: &i32, b: ^i32) {
    print(a)
    print(b)
}

var value = 10
var shared = &value

take_value(value)
take_shared(value)
take_shared(&value)
take_value(shared)
take_shared(shared)

var exclusive_value = 20
var exclusive = ^exclusive_value

take_value(exclusive)
take_exclusive(exclusive)

var a = 30
var b = 40

take_references(&a, ^b)
