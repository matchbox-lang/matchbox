func takeValue(n: i32) {
    print(n)
}

func takeShared(n: &i32) {
    print(n)
}

func takeExclusive(n: ^i32) {
    print(n)
}

func takeReferences(a: &i32, b: ^i32) {
    print(a)
    print(b)
}

var value = 10
var shared = &value

takeValue(value)
takeShared(value)
takeShared(&value)
takeValue(shared)
takeShared(shared)

var exclusiveValue = 20
var exclusive = ^exclusiveValue

takeValue(exclusive)
takeExclusive(exclusive)

var a = 30
var b = 40

takeReferences(&a, ^b)
