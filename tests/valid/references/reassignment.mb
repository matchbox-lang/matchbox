test "reassignment" {
    var first = 10
    var second = 20
    var shared: &i32 = &first

    shared = &second

    assert(shared == 20)

    if first != 10 {
        exit(1)
    }

    var third = 30
    var fourth = 40
    var exclusive: ^i32 = ^third

    exclusive = ^fourth

    assert(exclusive == 40)

    if third != 30 {
        exit(1)
    }
}
