func returnShared(n: &i32) -> &i32 {
    return n
}

func returnExclusive(n: ^i32) -> ^i32 {
    return n
}

var sharedValue = 10
var returnedShared: &i32 = returnShared(&sharedValue)

print(returnedShared)

var exclusiveValue = 20
var returnedExclusive: ^i32 = returnExclusive(^exclusiveValue)

print(returnedExclusive)
