func return_shared(n: &i32) -> &i32 {
    return n
}

func return_exclusive(n: ^i32) -> ^i32 {
    return n
}

var shared_value = 10
var returned_shared: &i32 = return_shared(&shared_value)

print(returned_shared)

var exclusive_value = 20
var returned_exclusive: ^i32 = return_exclusive(^exclusive_value)

print(returned_exclusive)
