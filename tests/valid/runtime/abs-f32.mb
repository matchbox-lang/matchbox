let negative: f32 = -12.5
let positive: f32 = 3.25
let zero: f32 = -0.0
let tiny: f32 = -1.0e-30

let absolute: f32 = abs(negative)
let unchanged: f32 = abs(positive)
let positiveZero: f32 = abs(zero)
let small: f32 = abs(tiny)
let literal = abs(-2.5)

print(absolute)
print(unchanged)
print(positiveZero)
print(small)
print(literal)
