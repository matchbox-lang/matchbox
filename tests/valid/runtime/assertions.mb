func check(value: i32) {
    let valid = value == 42

    assert(valid, "Unexpected value")
}

var calls = 0

func condition() -> bool {
    calls += 1

    return true
}

test "assertions" {
    assert(true)
    assert(true, "This should pass")

    check(42)

    let valid = condition()

    assert(valid)
    assert(calls == 1)
}
