func print_function_branch() {
    var before_branch = 70

    if true {
        var branch_value = 80

        assert(branch_value == 80)
    }

    assert(before_branch == 70)
}

test "branch binding isolation" {
    var first = 10
    var second = 20

    if true {
        var then_value = 30

        assert(then_value == 30)
    } else {
        var unused_else_value = 40

        assert(false)
    }

    if false {
        var unused_then_value = 50

        assert(false)
    } else {
        var else_value = 60

        assert(else_value == 60)
    }

    assert(first == 10)
    assert(second == 20)
}

test "branch bindings in functions" {
    print_function_branch()
}

test "conditional result bindings" {
    var conditional_value = if true {
        90
    } else {
        100
    }

    assert(conditional_value == 90)
}
