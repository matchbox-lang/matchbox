var first = 10
var second = 20

if true {
    var then_value = 30
    print(then_value)
} else {
    var unused_else_value = 40
    print(unused_else_value)
}

if false {
    var unused_then_value = 50
    print(unused_then_value)
} else {
    var else_value = 60
    print(else_value)
}

print(first)
print(second)

func print_function_branch() {
    var before_branch = 70

    if true {
        var branch_value = 80
        print(branch_value)
    }

    print(before_branch)
}

print_function_branch()

var conditional_value = if true {
    90
} else {
    100
}

print(conditional_value)
