test "division overflow" {
    let minimum32: i32 = -2147483648
    let minimum64: i64 = -9223372036854775808
    let minus_one32: i32 = -1
    let minus_one64: i64 = -1

    assert((minimum32 / minus_one32) == -2147483648)
    assert((minimum32 % minus_one32) == 0)
    assert((minimum64 / minus_one64) == -9223372036854775808)
    assert((minimum64 % minus_one64) == 0)
}
