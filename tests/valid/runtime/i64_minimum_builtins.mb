test "i64 minimum builtins" {
    var observed_steps = 0
    let result = min(-9223372036854775808, 0)

    assert(result == -9223372036854775808)

    observed_steps += 1

    let formatted = string("minimum:", -9223372036854775808)

    assert(formatted == "minimum:-9223372036854775808")

    assert(observed_steps == 1)
}
