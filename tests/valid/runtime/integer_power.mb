var base: i64 = 9007199254740993
var exponent: i64 = 1
let exact = pow(base, exponent)

assert(exact == 9007199254740993)

var minimum: i64 = -9223372036854775808
let two: i64 = 2
let negative_one: i64 = -1
let negative_three: i64 = -3
let negative_five: i64 = -5
let three: i64 = 3
let minimum_power = pow(minimum, exponent)
let wrapped = pow(minimum, two)
let even = pow(negative_one, minimum)
let truncated = pow(two, negative_three)
let negative = pow(negative_five, three)
let small = pow(5, 2)
let floating = pow(5.0, 2.0)

assert(minimum_power == minimum and wrapped == 0)
assert(even == 1 and truncated == 0)
assert(negative == -125 and small == 25)
assert(floating == 25.0)
