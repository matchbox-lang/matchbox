func compare(value) {
    print(value < -129)
    print(value < -128)
    print(value < -1)
    print(value < 0)
    print(value < 127)
    print(value < 128)
    print(value)
}

compare(-128)
compare(127)

let score = 82

if score >= 90 {
    print(4)
} else if score >= 80 {
    print(3)
} else {
    print(1)
}

print(score)
