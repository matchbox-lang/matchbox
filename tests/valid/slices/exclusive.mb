func double(values: ^i32[]) {
    for i in 0..len(values) {
        values[i] *= 2
    }
}

test "exclusive slices modify storage" {
    var values = [1, 2, 3]

    double(values)
    assert(values[0] == 2 and values[1] == 4 and values[2] == 6)

    let view: ^i32[] = values[1..3]
    view[0] += 10
    view[1] = 9

    assert(values[1] == 14 and values[2] == 9)
}
