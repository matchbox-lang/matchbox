let values = [1, 2, 3, 4]
var global_view: &i32[] = values

func global_middle() -> &i32[] {
    return global_view[1..3]
}

test "global slice and returned views" {
    let length = len(global_view)

    assert(length == 4)

    let view = global_middle()
    let view_length = len(view)

    assert(view_length == 2 and view[0] == 2 and view[1] == 3)
}
