func middle(values: &i32[]) -> &i32[] {
    return values[1..3]
}

test "slice returns and empty views" {
    let values = [1, 2, 3, 4]
    let selected = middle(values)
    let empty = selected[1..1]
    var count = 0

    for value in empty {
        count += value
    }

    let selected_length = len(selected)
    let empty_length = len(empty)

    assert(selected_length == 2)
    assert(selected[0] == 2)
    assert(empty_length == 0)
    assert(count == 0)
}
