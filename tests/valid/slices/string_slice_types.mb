test "declared string slices and full references" {
    let text = "hello"
    let whole: &string = text
    let part: &string = text[1..4]
    let explicit = &text
    let literal: &string = "ell"
    let length = len(part)
    let output = $"{whole}:{part}"
    let joined = part + '!'

    assert(whole == explicit)
    assert(length == 3)
    assert(part == literal)
    assert("ell" == part)
    assert(part != whole)
    assert(part != "hello")
    assert(output == "hello:ell")
    assert(joined == "ell!")
    
    print(part)
}
