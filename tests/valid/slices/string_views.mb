test "string view byte lengths and printing" {
    let text = "hello"
    let view = text[1..4]
    let nested = view[1..3]
    let alias = view
    let output = string(">", alias, "<", nested)
    let length = len(view)
    let text_length = len(text)
    var total = 0

    for byte in view {
        total += i32(byte)
    }

    print(view)
    assert(output == ">ell<ll")
    assert(length == 3)
    assert(text_length == 5)
    assert(view[0] == 101)
    assert(total == 317)
}
