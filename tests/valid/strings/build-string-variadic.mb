let empty = buildString()
let single = buildString("Hello")
let number = buildString("Count: ", 42)
let mixed = buildString("a", 'b', 3, true, 1.25, "!")
let zeros = buildString("a\0", '\0', "b")
let left = buildString("left", 1)
let right = buildString(2, "right")
let joined = buildString(left, " / ", right)

print(empty)
print(single)
print(number)
print(mixed)
print(zeros)
print(joined)
