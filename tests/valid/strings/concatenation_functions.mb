func join(left: char, right: string) -> string {
    return left + right
}

test "concatenation functions" {
    let letter = 'H'
    let word = "ello"
    let joined = join(letter, word)

    assert(joined == "Hello")

    let greeting = (letter + 'i') + '!' + " " + word

    assert(greeting == "Hi! ello")

    let empty_prefix = "" + letter

    assert(empty_prefix == "H")

    let empty_suffix = letter + ""

    assert(empty_suffix == "H")
}
