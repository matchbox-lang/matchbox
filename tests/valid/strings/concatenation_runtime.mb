test "concatenation runtime" {
    var left_char: char = '🌍'
    var right_char: char = '🌎'
    var left_string: string = "🌍"
    var right_string: string = "🌎"

    let characters = left_char + right_char

    assert(characters == "🌍🌎")

    let string_character = left_string + right_char

    assert(string_character == "🌍🌎")

    let character_string = left_char + right_string

    assert(character_string == "🌍🌎")

    let strings = left_string + right_string

    assert(strings == "🌍🌎")

    let punctuated = left_char + right_string + '!' + "!"

    assert(punctuated == "🌍🌎!!")
}
