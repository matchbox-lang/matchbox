test "interpolation" {
    let name = "Alice"
    let apples = 4
    let bananas = 3

    let apples_text = $"I have {apples} apples."

    assert(apples_text == "I have 4 apples.")

    let fruit_text = $"I have {apples + bananas} fruit."

    assert(fruit_text == "I have 7 fruit.")

    let greeting = $"Hello {{{name}}}."

    assert(greeting == "Hello {Alice}.")

    let path = $`C:\path\{name}\`

    assert(path == "C:\\path\\Alice\\")

    let braces = $"{{}} {name}{apples}"

    assert(braces == "{} Alice4")

    let unicode = $"\u{1F600} {name}"

    assert(unicode == "😀 Alice")

    let empty = $""

    assert(empty == "")
}
