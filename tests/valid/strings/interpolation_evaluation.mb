var count = 0

func next() -> i32 {
    count += 1
    return count
}

test "interpolation evaluation" {
    let first = $"{next()} / {next()} / {next()}"

    assert(first == "1 / 2 / 3")
    assert(count == 3)

    let second = $"{count} / {next()} / {count}"

    assert(second == "3 / 4 / 4")
    assert(count == 4)
}
