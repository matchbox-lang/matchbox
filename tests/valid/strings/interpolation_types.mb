let small: i8 = -128
let medium: i16 = -32768
let large: i64 = -9223372036854775808
let byte: u8 = 255
let word: u16 = 65535
let unsigned: u32 = 4294967295
let wide: u64 = 18446744073709551615
let single: f32 = 1.25
let double: f64 = 1.25

print($"{small}\n{medium}\n{large}")
print($"{byte}\n{word}\n{unsigned}\n{wide}")
print($"{single}\n{double}\n{true}\n{false}\n{'\u{E9}'}\n{'\0'}")
