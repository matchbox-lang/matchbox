test "interpolation types" {
    let small: i8 = -128
    let medium: i16 = -32768
    let large: i64 = -9223372036854775808
    let byte: u8 = 255
    let hword: u16 = 65535
    let unsigned: u32 = 4294967295
    let wide: u64 = 18446744073709551615
    let single: f32 = 1.25
    let double: f64 = 1.25

    let signed_values = $"{small}\n{medium}\n{large}"

    assert(signed_values == "-128\n-32768\n-9223372036854775808")

    let unsigned_values = $"{byte}\n{hword}\n{unsigned}\n{wide}"

    assert(unsigned_values == "255\n65535\n4294967295\n18446744073709551615")

    let other_values = $"{single}\n{double}\n{true}\n{false}\n{'\u{E9}'}\n{'\0'}"

    assert(other_values == "1.25\n1.25\ntrue\nfalse\né\n\0")
}
