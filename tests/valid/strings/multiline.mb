test "multiline" {
    let escaped = """Multi
Line
String\n"""

    assert(escaped == "Multi\r\nLine\r\nString\n")

    let raw = ```Multi
Line
String
```

    assert(raw == "Multi\r\nLine\r\nString\r\n")

    let quoted = """Hello "Alice"!"""

    assert(quoted == "Hello \"Alice\"!")

    let triple_quoted = """"Hello """Alice"""!""""

    assert(triple_quoted == "Hello \"\"\"Alice\"\"\"!")

    let quadruple_quoted = """""Hello """"Alice""""!"""""

    assert(quadruple_quoted == "Hello \"\"\"\"Alice\"\"\"\"!")

    let literal_braces = """I have {apples} apples."""

    assert(literal_braces == "I have {apples} apples.")
}
