test "raw" {
    let path = `C:\path\to\file`

    assert(path == "C:\\path\\to\\file")

    let trailing_slash = `trailing\`

    assert(trailing_slash == "trailing\\")

    let literal_escapes = `\n\u{1F600} {literal}`

    assert(literal_escapes == "\\n\\u{1F600} {literal}")

    let empty = ``

    assert(empty == "")
}
