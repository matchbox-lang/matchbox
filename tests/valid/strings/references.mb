func exclusive(value: ^string) {
    print(value)
}

func display(value: &string) {
    print(value)
}

var value = "Original"

exclusive(^value)
display(&value)

func capture(value: &string) -> string {
    return string(value)
}

let captured = capture(&value)
value = "Updated"

print(captured)
print(value)
