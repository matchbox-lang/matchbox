func exclusive(value: ^string) {
    assert(value == "Original")
}

func display(value: &string) {
    assert(value == "Original")
}

func capture(value: &string) -> string {
    return string(value)
}

test "references" {
    var value = "Original"

    exclusive(^value)
    display(&value)

    let captured = capture(&value)
    value = "Updated"

    assert(captured == "Original")
    assert(value == "Updated")
}
