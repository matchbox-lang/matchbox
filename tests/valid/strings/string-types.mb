let small: i8 = -128
let medium: i16 = -32768
let integer: i32 = -2147483648
let large: i64 = -9223372036854775808
let byte: u8 = 255
let word: u16 = 65535
let unsigned: u32 = 4294967295
let wide: u64 = 18446744073709551615
let single: f32 = 1.25
let double: f64 = 1.25

let signedParts = string(small, " ", medium, " ", integer, " ", large)
let unsignedParts = string(byte, " ", word, " ", unsigned, " ", wide)
let otherParts = string(single, " ", double, " ", true, " ", false, " ", '\u{1F600}')

print(signedParts)
print(unsignedParts)
print(otherParts)

print(small, " ", medium, " ", integer, " ", large)
print(byte, " ", word, " ", unsigned, " ", wide)
print(single, " ", double, " ", true, " ", false, " ", '\u{1F600}')

let largestSingle: f32 = -3.4028234e38
let largestDouble: f64 = -1.7976931348623157e308
let floatingLimits = string(largestSingle, " ", largestDouble, " ", -0.0)

print(floatingLimits)
