let empty = string()
let single = string("Hello")
let number = string("Count: ", 42)
let mixed = string("a", 'b', 3, true, 1.25, "!")
let zeros = string("a\0", '\0', "b")
let left = string("left", 1)
let right = string(2, "right")
let joined = string(left, " / ", right)

print(empty)
print(single)
print(number)
print(mixed)
print(zeros)
print(joined)
