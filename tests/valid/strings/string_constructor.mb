func message(value: string) -> string {
    return string("Count: ", value)
}

test "string constructor" {
    let count = 5
    let converted: string = string(count)
    let constructed: string = message(converted)
    let interpolated: string = $"Count: {count}"

    assert(constructed == "Count: 5")
    assert(interpolated == "Count: 5")
}
