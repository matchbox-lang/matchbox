test "string text" {
    let chars = string('H', 'i')
    let string_char = string("Hell", 'o')
    let char_string = string('H', "ello")
    let strings = string("H", "ello")

    assert(chars == "Hi")
    assert(string_char == "Hello")
    assert(char_string == "Hello")
    assert(strings == "Hello")
}
