test "string text variadic" {
    let empty = string()
    let single = string("Hello")
    let mixed = string("a", 'b', "c", 'd', "e", '!')
    let zeros = string("a\0", '\0', "b")
    let unicode = string('\u{1F600}', " / ", '\u{E9}')

    assert(empty == "")
    assert(single == "Hello")
    assert(mixed == "abcde!")
    assert(zeros == "a\0\0b")
    assert(unicode == "😀 / é")
}
