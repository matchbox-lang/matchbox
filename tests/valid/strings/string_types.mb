let small: i8 = -128
let medium: i16 = -32768
let integer: i32 = -2147483648
let large: i64 = -9223372036854775808
let byte: u8 = 255
let word: u16 = 65535
let unsigned: u32 = 4294967295
let wide: u64 = 18446744073709551615
let single: f32 = 1.25
let double: f64 = 1.25

let signed_parts = string(small, " ", medium, " ", integer, " ", large)
let unsigned_parts = string(byte, " ", word, " ", unsigned, " ", wide)
let other_parts = string(single, " ", double, " ", true, " ", false, " ", '\u{1F600}')

print(signed_parts)
print(unsigned_parts)
print(other_parts)

print(small, " ", medium, " ", integer, " ", large)
print(byte, " ", word, " ", unsigned, " ", wide)
print(single, " ", double, " ", true, " ", false, " ", '\u{1F600}')

let largest_single: f32 = -3.4028234e38
let largest_double: f64 = -1.7976931348623157e308
let floating_limits = string(largest_single, " ", largest_double, " ", -0.0)

print(floating_limits)
