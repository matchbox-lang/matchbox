test "tuple arithmetic" {
    let a = (8, 9)
    let b = (2, 3)

    assert((a + b) == (10, 12))
    assert((a - b) == (6, 6))
    assert((a * b) == (16, 27))
    assert((a / b) == (4, 3))
    assert((a % b) == (0, 0))
    assert((a ** b) == (64, 729))
    assert((a & b) == (0, 1))
    assert((a | b) == (10, 11))
    assert((a ^ b) == (10, 10))
    assert((a << b) == (32, 72))
    assert((a >> b) == (2, 1))
    assert(((a + b) * b) == (20, 36))
    assert(((1, (2, 3)) - (4, (5, 6))) == (-3, (-3, -3)))
}
