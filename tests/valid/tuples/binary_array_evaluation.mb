var calls = 0

func values() -> (i32[2], i32) {
    calls += 1
    return ([calls, calls * 10], calls)
}

func difference(left: &(i32[2], i32), right: &(i32[2], i32)) -> (i32[2], i32) {
    return left - right
}

test "tuple array operands evaluate once from left to right" {
    let result = values() - values()
    let first = ([8, 9], 20)
    let second = ([2, 3], 5)
    let borrowed = difference(first, second)

    assert(calls == 2)
    assert(result == ([-1, -10], -1))
    assert(borrowed == ([6, 6], 15))
    assert(first == ([8, 9], 20))
    assert(second == ([2, 3], 5))
}
