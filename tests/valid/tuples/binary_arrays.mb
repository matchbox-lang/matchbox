test "tuple array arithmetic" {
    let left = ([8, 9], 20)
    let right = ([2, 3], 5)
    let sum = left + right

    assert(sum == ([10, 12], 25))
    assert((([10], 20) + ([5], 5)) == ([15], 25))
    assert((left - right) == ([6, 6], 15))
    assert((left * right) == ([16, 27], 100))
    assert((left / right) == ([4, 3], 4))
    assert((left % right) == ([0, 0], 0))
    assert((left ** right) == ([64, 729], 3200000))
    assert((left & right) == ([0, 1], 4))
    assert((left | right) == ([10, 11], 21))
    assert((left ^ right) == ([10, 10], 17))
    assert((left << right) == ([32, 72], 640))
    assert((left >> right) == ([2, 1], 0))
    assert(left == ([8, 9], 20))
    assert(right == ([2, 3], 5))

    sum[0][0] = 99

    assert(left[0][0] == 8)
}

test "tuple array comparisons" {
    let left = ([1, 3], 20)
    let right = ([2, 3], 5)

    assert((left < right) == ([true, false], false))
    assert((left <= right) == ([true, true], false))
    assert((left > right) == ([false, false], true))
    assert((left >= right) == ([false, true], true))
    assert((left <=> right) == ([-1, 0], 1))
    assert(left != right)
    assert(left != ([1, 4], 20))
    assert(left != ([1], 20))
    assert(not (left == ([1], 20)))
    assert(left === ([1, 3], 20))
    assert(left !== right)
    assert(not (left != ([1, 3], 20)))
}
