test "tuple comparisons and equality" {
    let a = (1, 3, 2)
    let b = (2, 3, 1)

    assert((a < b) == (true, false, false))
    assert((a <= b) == (true, true, false))
    assert((a > b) == (false, false, true))
    assert((a >= b) == (false, true, true))
    assert((a <=> b) == (-1, 0, 1))
    assert(a == (1, 3, 2))
    assert(a != b)
    assert(not (a == b))
    assert(not (a != (1, 3, 2)))
    assert(a === (1, 3, 2))
    assert(a !== b)
    assert(a != (1, 3))
    assert((1, (2, 3)) != ((1, 2), 3))
    assert((1, (2, 3)) == (1, (2, 3)))
    assert((1, (2, 3)) != (1, (2, 4)))
    assert(() == ())
    assert(not (() != ()))
}
