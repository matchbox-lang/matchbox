test "empty iteration" {
    var count = 0

    for value in [(), ()] {
        assert(string(value) == "()")
        count += 1
    }

    assert(count == 2)
}

test "tuple iteration" {
    let values = [([1], "first"), ([2], "second")]
    var sum = 0

    for value in values {
        value[0][0] += 10
        sum += value[0][0]
    }

    assert(sum == 23)
    assert(values[0][0][0] == 1)
    assert(values[1][1] == "second")
}
