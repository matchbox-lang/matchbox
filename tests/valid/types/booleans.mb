test "booleans" {
    let yes: bool = true
    let no = false
    let equal = yes == not no
    let different = yes != no
    let combined = equal and different or false

    assert(yes)
    assert(not (no))
    assert(combined)

    let selected = if combined {
        true
    } else {
        false
    }

    assert(selected)

    let inverted = not if combined {
        true
    } else {
        false
    }

    assert(not (inverted))
}
