func select(choose: bool, left: f32, right: f32) -> f64 {
    let result: f64 = if choose {
        left
    } else {
        right
    }

    return result
}

test "conditional float argument widening" {
    let selected_then = select(true, 2.5, -3.75)
    let selected_else = select(false, 2.5, -3.75)

    assert(selected_then == 2.5)
    assert(selected_else == -3.75)
}
