test "dynamic conditional float widening" {
    let narrow: f32 = 2.5
    let other: f32 = -3.75
    var choose = true

    let selected_then: f64 = if choose {
        narrow
    } else {
        other
    }

    choose = false

    let selected_else: f64 = if choose {
        narrow
    } else {
        other
    }

    assert(selected_then == 2.5)
    assert(selected_else == -3.75)
}
