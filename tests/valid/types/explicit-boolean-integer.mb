func convert(value: bool) {
    let signed8 = i8(value)
    let signed16 = i16(value)
    let signed32 = i32(value)
    let signed64 = i64(value)
    let unsigned8 = u8(value)
    let unsigned16 = u16(value)
    let unsigned32 = u32(value)
    let unsigned64 = u64(value)

    print(signed8)
    print(signed16)
    print(signed32)
    print(signed64)
    print(unsigned8)
    print(unsigned16)
    print(unsigned32)
    print(unsigned64)
}

convert(true)
convert(false)

let constantTrue = i32(true)
let constantFalse = i32(false)

print(constantTrue)
print(constantFalse)
