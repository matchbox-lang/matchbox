func convert(value: bool, expected: u8) {
    let signed8 = i8(value)
    let signed16 = i16(value)
    let signed32 = i32(value)
    let signed64 = i64(value)
    let unsigned8 = u8(value)
    let unsigned16 = u16(value)
    let unsigned32 = u32(value)
    let unsigned64 = u64(value)

    assert(signed8 == expected)
    assert(signed16 == expected)
    assert(signed32 == expected)
    assert(signed64 == expected)
    assert(unsigned8 == expected)
    assert(unsigned16 == expected)
    assert(unsigned32 == expected)
    assert(unsigned64 == expected)
}

test "explicit boolean integer" {
    convert(true, 1)
    convert(false, 0)

    let constant_true = i32(true)
    let constant_false = i32(false)

    assert(constant_true == 1)
    assert(constant_false == 0)
}
