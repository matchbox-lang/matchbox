func widen(value: f32) -> f64 {
    return f64(value)
}

func preserve(value: f64) -> f64 {
    return f64(value)
}

test "explicit float conversions" {
    let widened = widen(2.5)
    let identity = preserve(3.5)
    let constant = f64(4.5)

    assert(widened == 2.5)
    assert(identity == 3.5)
    assert(constant == 4.5)
}
