func convert(value: i64) {
    let narrow = f32(value)
    let wide = f64(value)

    print(narrow)
    print(wide)
}

func narrow(value: f64) -> f32 {
    return f32(value)
}

convert(16777217)
convert(9007199254740993)

let narrowed = narrow(16777217.0)
let rounded = f32(16777217)

print(narrowed)
print(rounded)

let overflow = narrow(1e100)
let underflow = f32(1e-100)

print(overflow)
print(underflow)
