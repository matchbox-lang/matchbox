func convert(value: i64, expected_narrow: f32, expected_wide: f64) {
    let narrow = f32(value)
    let wide = f64(value)

    assert(narrow == expected_narrow)
    assert(wide == expected_wide)
}

func narrow(value: f64) -> f32 {
    return f32(value)
}

test "explicit integer floating" {
    convert(16777217, 16777216.0, 16777217.0)
    convert(9007199254740993, 9007199254740992.0, 9007199254740992.0)

    let narrowed = narrow(16777217.0)
    let rounded = f32(16777217)

    assert(narrowed == 16777216.0)
    assert(rounded == 16777216.0)

    let overflow = narrow(1e100)
    let underflow = f32(1e-100)

    assert(overflow == f32.INFINITY)
    assert(underflow == 0.0)
}
