func narrow(value: i64, expected_signed: i64[3], expected_unsigned: u64[4]) {
    let signed_byte = i8(value)
    let unsigned_byte = u8(value)
    let hword = i16(value)
    let unsigned_hword = u16(value)
    let signed = i32(value)
    let unsigned = u32(value)
    let wide_unsigned = u64(value)

    assert(signed_byte == expected_signed[0])
    assert(unsigned_byte == expected_unsigned[0])
    assert(hword == expected_signed[1])
    assert(unsigned_hword == expected_unsigned[1])
    assert(signed == expected_signed[2])
    assert(unsigned == expected_unsigned[2])
    assert(wide_unsigned == expected_unsigned[3])
}

test "explicit integer narrowing" {
    narrow(511, [-1, 511, 511], [255, 511, 511, 511])
    narrow(-129, [127, -129, -129], [127, 65407, 4294967167, 18446744073709551487])
    narrow(32768, [0, -32768, 32768], [0, 32768, 32768, 32768])
    narrow(65535, [-1, -1, 65535], [255, 65535, 65535, 65535])
    narrow(-32769, [-1, 32767, -32769], [255, 32767, 4294934527, 18446744073709518847])

    let constant = i8(511)
    let unsigned_constant = u64(-1)

    assert(constant == -1)
    assert(unsigned_constant == 18446744073709551615)
}
