test "float literal explicit narrowing" {
    let narrow: f32 = 16777217.0
    let tiny: f32 = 1.0e-50

    assert((narrow == 16777216.0))
    assert((tiny == 0.0))

    let widened: f64 = narrow
    let widened_tiny: f64 = tiny

    assert((widened == 16777216.0))
    assert((widened_tiny == 0.0))
}
