var condition = true
let narrow: f32 = 2.5

let selected: f64 = if condition {
    narrow
} else {
    narrow
}

if selected != 2.5 {
    exit(1)
}

let wide: i64 = if condition {
    3000000000
} else {
    4000000000
}

if wide != 3000000000 {
    exit(1)
}

var left = 10
var right = 20

let shared: &i32 = if condition {
    &left
} else {
    &right
}

if shared != 10 {
    exit(1)
}

let exclusive: ^i32 = if condition {
    ^left
} else {
    ^right
}

if exclusive != 10 {
    exit(1)
}
