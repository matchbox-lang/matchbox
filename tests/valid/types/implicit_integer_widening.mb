func widen_argument(value: i64) -> i64 {
    return value
}

func widen_return(value: i8) -> i64 {
    return value
}

func integer_to_float_argument(value: f64) -> f64 {
    return value
}

func integer_to_float_return(value: i32) -> f64 {
    return value
}

test "integer width widening" {
    let signed8: i8 = -25
    let signed16: i16 = signed8
    let signed32: i32 = signed16
    let signed64: i64 = signed32
    let unsigned8: u8 = 25
    let unsigned16: u16 = unsigned8
    let unsigned32: u32 = unsigned16
    let unsigned64: u64 = unsigned32
    var assigned: i64
    assigned = signed8

    assert(signed32 == -25)
    widen_argument(signed8)
    widen_return(signed8)
}

test "integer to floating point widening" {
    let signed8: i8 = -25
    let signed16: i16 = signed8
    let signed32: i32 = signed16
    let unsigned8: u8 = 25
    let unsigned16: u16 = unsigned8
    let unsigned32: u32 = unsigned16
    let signed_float32: f32 = signed16
    let unsigned_float32: f32 = unsigned16
    let signed_float64: f64 = signed32
    let unsigned_float64: f64 = unsigned32

    assert(signed_float32 == -25.0)
    assert(unsigned_float32 == 25.0)
    assert(signed_float64 == -25.0)
    assert(unsigned_float64 == 25.0)
}

test "integer literal floating point contexts" {
    let literal_float32: f32 = 4
    let literal_float64: f64 = 16777217
    var assigned_float: f32
    assigned_float = 4

    assert(literal_float32 == 4.0)
    assert(literal_float64 == 16777217.0)
    assert(assigned_float == 4.0)
}

test "integer widening through floating point parameters" {
    let signed8: i8 = -25
    let signed16: i16 = signed8
    let signed32: i32 = signed16
    let argument_result = integer_to_float_argument(signed32)

    assert(argument_result == -25.0)

    let return_result = integer_to_float_return(signed32)

    assert(return_result == -25.0)
}
