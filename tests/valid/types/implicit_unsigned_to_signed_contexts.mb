func accept(value: i64) -> i64 {
    return value
}

func widen(value: u32) -> i64 {
    return value
}

test "implicit unsigned to signed" {
    let source: u32 = 4294967295
    var assigned: i64 = 0
    assigned = source

    assert(assigned == 4294967295)

    let accepted = accept(source)

    assert(accepted == 4294967295)

    let widened = widen(source)

    assert(widened == 4294967295)
}
