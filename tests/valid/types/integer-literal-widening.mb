let negative: i32 = -25
let folded = 1 - 26
let positive: u32 = 4294967295
let widenedNegative: i64 = negative
let widenedFolded: i64 = folded
let widenedPositive: u64 = positive

print(widenedNegative == -25)
print(widenedFolded == -25)
print(widenedPositive == 4294967295)

func widen(value: i64) -> i64 {
    return value
}

print(widen(negative) == -25)

let minimum = -2147483648
let minimum32: i32 = minimum
let minimum64: i64 = -2147483648
let minimumBuiltin: i32 = min(-2147483648, 0)
let belowMinimum = -2147483649
let positiveBoundary = 2147483648

print(minimum32)
print(minimum64)
print(minimumBuiltin)
print(belowMinimum)
print(positiveBoundary)
