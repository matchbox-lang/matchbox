func widen(value: i64) -> i64 {
    return value
}

test "integer literal widening" {
    let negative: i32 = -25
    let folded = 1 - 26
    let positive: u32 = 4294967295
    let widened_negative: i64 = negative
    let widened_folded: i64 = folded
    let widened_positive: u64 = positive

    assert((widened_negative == -25))
    assert((widened_folded == -25))
    assert((widened_positive == 4294967295))

    let widened_matches = widen(negative) == -25

    assert(widened_matches)

    let minimum = -2147483648
    let minimum32: i32 = minimum
    let minimum64: i64 = -2147483648
    let minimum_builtin: i32 = min(-2147483648, 0)
    let below_minimum = -2147483649
    let positive_boundary = 2147483648

    assert(minimum32 == -2147483648)
    assert(minimum64 == -2147483648)
    assert(minimum_builtin == -2147483648)
    assert(below_minimum == -2147483649)
    assert(positive_boundary == 2147483648)
}
