let inferred = 123
let signed8: i8 = 127
let signed16: i16 = 32767
let signed32: i32 = 2147483647
let signed64: i64 = 9223372036854775807
let unsigned8: u8 = 255
let unsigned16: u16 = 65535
let unsigned32: u32 = 4294967295
let unsigned64: u64 = 18446744073709551615

let minimum8: i8 = -128
let minimum16: i16 = -32768
let minimum32: i32 = -2147483648
let minimum64: i64 = -9223372036854775808

let wrapped8: u8 = unsigned8 + 1
let wrapped16: u16 = unsigned16 + 1
let wrapped32: u32 = unsigned32 + 1
let wrapped64: u64 = unsigned64 + 1

func preservePositions(first: i64, second: i32, third: u64) -> i32 {
    return second
}

func preserveWide(value: u64) -> u64 {
    return value
}

let returned64 = preserveWide(unsigned64)
let preserved = preservePositions(signed64, inferred, returned64)

print(preserved)

let promotedSum: i32 = sum(signed8, 1)
let wideSum: u64 = sum(unsigned64, 1)
let lowest: i32 = min(signed8, minimum8, 0)
let highest: u64 = max(unsigned64, 0, 1)

print(promotedSum)
print(wideSum)
print(lowest)
print(highest)

let mixedSum: i64 = sum(signed8, unsigned32, 1)

print(mixedSum)

let signedTotal32: i32 = sum(minimum32, -1)
let signedTotal64: i64 = sum(minimum64, -1)
let unsignedTotal32: u32 = sum(unsigned32, 0)
let unsignedTotal64: u64 = sum(unsigned64, 0)

if signedTotal32 != signed32 or signedTotal64 != signed64 {
    exit(1)
}

if unsignedTotal32 != unsigned32 or unsignedTotal64 != unsigned64 {
    exit(1)
}

let unsignedWrap32: u32 = sum(unsigned32, 1, 1)
let unsignedWrap64: u64 = sum(unsigned64, 1, 1)

if unsignedWrap32 != 1 or unsignedWrap64 != 1 {
    exit(1)
}
