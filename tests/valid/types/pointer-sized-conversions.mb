func convert(signed: isize, unsigned: usize, wide: i64, huge: u64, floating: f64, flag: bool) {
    let signedWide: i64 = signed
    let unsignedWide: u64 = unsigned
    let fromWide = isize(wide)
    let fromHuge = usize(huge)
    let signedFloat = f64(signed)
    let unsignedFloat = f32(unsigned)
    let fromFloat = isize(floating)
    let unsignedFromFloat = usize(floating)
    let fromBool = usize(flag)
    let narrow = i8(signed)
    let unsignedBits = usize(signed)
    let restored = isize(unsignedBits)

    if signedWide != -123 or unsignedWide != 200 or fromWide != -123 or fromHuge != 200 {
        exit(1)
    }

    if signedFloat != -123.0 or unsignedFloat != 200.0 or fromFloat != 12 or unsignedFromFloat != 12 {
        exit(1)
    }

    if fromBool != 1 or narrow != -123 or restored != signed {
        exit(1)
    }
}

convert(-123, 200, -123, 200, 12.75, true)

let signed = isize(-123)
let unsigned = usize(200)
let floating = isize(12.75)
let boolean = usize(true)
let character = usize('A')

if signed != -123 or unsigned != 200 or floating != 12 or boolean != 1 or character != 65 {
    exit(1)
}

func truncate(wide: u64, signedWide: i64) {
    let pointer = usize(wide)
    let restored = u64(pointer)
    let maximum = usize(-1)
    let mask = u64(maximum)
    let expected = wide & mask
    let signedPointer = isize(signedWide)
    let signedRestored = i64(signedPointer)

    if restored != expected or signedRestored != -1 {
        exit(1)
    }
}

truncate(4294967297, -1)
truncate(18446744073709551615, -1)

func widen(value: u32) {
    let computed = value + 0
    let pointer = usize(computed)
    let wide = u64(pointer)

    if wide != 4294967295 {
        exit(1)
    }
}

widen(4294967295)
