func preserve(value: isize, marker: i32, unsigned: usize) -> isize {
    if marker != 42 or unsigned != 200 {
        exit(1)
    }

    return value
}

func read(value: &usize) -> usize {
    return value + 0
}

let negative: isize = -123
var unsigned: usize = 200
let returned = preserve(negative, 42, unsigned)
let read_back = read(&unsigned)

unsigned += 2

if returned != -123 or unsigned != 202 or read_back != 200 {
    exit(1)
}

let doubled = negative * 2
let quotient = doubled / negative
let remainder = unsigned % 10
let shifted = unsigned << 2
let ordering = negative <=> returned

if doubled != -246 or quotient != 2 or remainder != 2 or shifted != 808 or ordering != 0 {
    exit(1)
}

let maximum = usize(-1)
let wrapped = maximum + 1
let half = maximum >> 1
let positive = isize(half)
let minimum = -positive - 1
let negated = -negative

if wrapped != 0 or maximum <= half or minimum >= negative or positive <= 0 or negated != 123 {
    exit(1)
}

let branch: isize = if unsigned == 202 {
    negative
} else {
    returned
}

let matched = match unsigned {
    case 201 | 202: negative
    default: returned
}

if branch != -123 or matched != -123 {
    exit(1)
}

print(negative, unsigned, maximum, minimum)
print($"Values: {negative}, {unsigned}")
