var condition = true
let narrow: f32 = 2.5
let selected: f64 = condition ?
    narrow
    : narrow

if selected != 2.5 {
    exit(1)
}

let wide: i64 = condition ?
    3000000000
    : 4000000000

if wide != 3000000000 {
    exit(1)
}

var left = 10
var right = 20
let shared: &i32 = condition ?
    &left
    : &right

if shared != 10 {
    exit(1)
}

let exclusive: ^i32 = condition ?
    ^left
    : ^right

if exclusive != 10 {
    exit(1)
}
