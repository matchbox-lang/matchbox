func widen(small: u8, medium: u16) {
    let byte: u8 = small + small
    let hword: u16 = medium + medium
    let signed_byte: i16 = byte
    let signed_hword: i32 = hword
    let wide_byte: u64 = byte
    let wide_hword: i64 = hword
    let float_byte: f32 = byte
    let float_hword: f64 = hword

    assert(byte == 200)
    assert(hword == 40000)
    assert(signed_byte == 200)
    assert(signed_hword == 40000)
    assert(wide_byte == 200)
    assert(wide_hword == 40000)
    assert(float_byte == 200.0)
    assert(float_hword == 4e+4)
    assert((byte + signed_hword) == 40200)
    assert((signed_hword + byte) == 40200)
}

test "unsigned result widening" {
    widen(100, 20000)
}
