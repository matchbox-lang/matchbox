func preserve32(value: f32) -> f32 {
    return value
}

func preserve64(value: f64) -> f64 {
    return value
}

func literal64() -> f64 {
    return 56.78
}

test "typed float literals" {
    let a: f32 = 12.34
    let b: f32 = 12.34e2
    let c: f64 = 12.34
    let d: f64 = 12.34e2

    assert(a == 12.34)
    assert(b == 1234.0)
    assert(c == 12.34)
    assert(d == 1234.0)
}

test "float arguments and returns" {
    let a: f32 = 12.34
    let c: f64 = 12.34
    let returned32 = preserve32(a)
    let returned64 = preserve64(c)
    let contextual64 = preserve64(90.12)

    assert(returned32 == 12.34)
    assert(returned64 == 12.34)

    let returned_literal = literal64()

    assert(returned_literal == 56.78)
    assert(contextual64 == 90.12)
}

test "float literal syntax" {
    let large: f64 = 1.0e100
    let inferred_large = 1e100
    let leading_decimal = .2
    let leading_decimal_exponent = .2e2
    let leading_zeros = 001.2

    assert(large == 1e+100)
    assert(inferred_large == 1e+100)
    assert(leading_decimal == 0.2)
    assert(leading_decimal_exponent == 20.0)
    assert(leading_zeros == 1.2)
}

test "float math functions" {
    let exponential = exp(1.0)
    let natural_logarithm = log(2.0)
    let decimal_logarithm = log10(100.0)
    let binary_logarithm = log2(8.0)
    let sine = sin(0.5)
    let cosine = cos(0.5)
    let tangent = tan(0.5)

    assert(exponential >= 2.7182817 - 0.00001)
    assert(exponential <= 2.7182817 + 0.00001)
    assert(natural_logarithm >= 0.6931472 - 0.00001)
    assert(natural_logarithm <= 0.6931472 + 0.00001)
    assert(decimal_logarithm >= 2.0 - 0.00001)
    assert(decimal_logarithm <= 2.0 + 0.00001)
    assert(binary_logarithm >= 3.0 - 0.00001)
    assert(binary_logarithm <= 3.0 + 0.00001)
    assert(sine >= 0.47942555 - 0.00001)
    assert(sine <= 0.47942555 + 0.00001)
    assert(cosine >= 0.87758255 - 0.00001)
    assert(cosine <= 0.87758255 + 0.00001)
    assert(tangent >= 0.5463025 - 0.00001)
    assert(tangent <= 0.5463025 + 0.00001)
}

test "whole float values" {
    let whole32: f32 = 25.0
    let whole64: f64 = 25.0
    let positive = 25.0
    let negative = -25.0

    assert(whole32 == 25.0)
    assert(whole64 == 25.0)
    assert(positive == 25.0)
    assert(negative == -25.0)
}

test "signed float zero" {
    let positive = 0.0
    let negative = -0.0
    let positive_reciprocal = 1.0 / positive
    let negative_reciprocal = 1.0 / negative

    assert(positive == negative)
    assert(positive_reciprocal == f32.INFINITY)
    assert(negative_reciprocal == f32.NEG_INFINITY)
}

test "float epsilon and exponents" {
    let small_exponent: f64 = 1e-9
    let large_exponent: f64 = 1e9

    assert((f32.EPSILON) == 1.1920929e-7)
    assert((f64.EPSILON) == 2.220446049250313e-16)
    assert(small_exponent == 1e-9)
    assert(large_exponent == 1e+9)

    let negative_epsilon = $"{-f32.EPSILON}"

    assert(negative_epsilon == "-1.1920929e-7")
}

test "special float values" {
    let interpolated_single = $"{f32.NAN} {f32.INFINITY} {f32.NEG_INFINITY} {-f32.NAN}"

    assert(interpolated_single == "NaN Infinity -Infinity NaN")

    let interpolated_double = $"{f64.NAN} {f64.INFINITY} {f64.NEG_INFINITY} {-f64.NAN}"

    assert(interpolated_double == "NaN Infinity -Infinity NaN")

    let constructed_single = string(f32.NAN, " ", f32.INFINITY, " ", f32.NEG_INFINITY)

    assert(constructed_single == "NaN Infinity -Infinity")

    let constructed_double = string(f64.NAN, " ", f64.INFINITY, " ", f64.NEG_INFINITY)

    assert(constructed_double == "NaN Infinity -Infinity")
}
