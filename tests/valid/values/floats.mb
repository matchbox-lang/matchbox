let a: f32 = 12.34
let b: f32 = 12.34e2
let c: f64 = 12.34
let d: f64 = 12.34e2
let large: f64 = 1.0e100
let leadingDecimal = .2
let leadingDecimalExponent = .2e2
let leadingZeros = 001.2

func preserve32(value: f32) -> f32 {
    return value
}

func preserve64(value: f64) -> f64 {
    return value
}

func literal64() -> f64 {
    return 56.78
}

let returned32 = preserve32(a)
let returned64 = preserve64(c)
let contextual64 = preserve64(90.12)

print(returned32)
print(b)
print(returned64)
print(d)
print(literal64())
print(contextual64)
print(large)
print(leadingDecimal)
print(leadingDecimalExponent)
print(leadingZeros)
