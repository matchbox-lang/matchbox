let a: f32 = 12.34
let b: f32 = 12.34e2
let c: f64 = 12.34
let d: f64 = 12.34e2

let large: f64 = 1.0e100
let inferredLarge = 1e100
let leadingDecimal = .2
let leadingDecimalExponent = .2e2
let leadingZeros = 001.2

func preserve32(value: f32) -> f32 {
    return value
}

func preserve64(value: f64) -> f64 {
    return value
}

func literal64() -> f64 {
    return 56.78
}

let returned32 = preserve32(a)
let returned64 = preserve64(c)
let contextual64 = preserve64(90.12)

print(a)
print(b)
print(c)
print(d)

print(returned32)
print(returned64)
print(literal64())
print(contextual64)
print(large)
print(inferredLarge)
print(leadingDecimal)
print(leadingDecimalExponent)
print(leadingZeros)

let exponential = exp(1.0)
let naturalLogarithm = log(2.0)
let decimalLogarithm = log10(100.0)
let binaryLogarithm = log2(8.0)
let sine = sin(0.5)
let cosine = cos(0.5)
let tangent = tan(0.5)

print(exponential)
print(naturalLogarithm)
print(decimalLogarithm)
print(binaryLogarithm)
print(sine)
print(cosine)
print(tangent)

let whole32: f32 = 25.0
let whole64: f64 = 25.0

print(25.0)
print(whole32)
print(whole64)
print(0.0)
print(-0.0)
print(-25.0)
