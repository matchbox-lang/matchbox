let a: f32 = 12.34
let b: f32 = 12.34e2
let c: f64 = 12.34
let d: f64 = 12.34e2

let large: f64 = 1.0e100
let inferred_large = 1e100
let leading_decimal = .2
let leading_decimal_exponent = .2e2
let leading_zeros = 001.2

func preserve32(value: f32) -> f32 {
    return value
}

func preserve64(value: f64) -> f64 {
    return value
}

func literal64() -> f64 {
    return 56.78
}

let returned32 = preserve32(a)
let returned64 = preserve64(c)
let contextual64 = preserve64(90.12)

print(a)
print(b)
print(c)
print(d)

print(returned32)
print(returned64)
print(literal64())
print(contextual64)
print(large)
print(inferred_large)
print(leading_decimal)
print(leading_decimal_exponent)
print(leading_zeros)

let exponential = exp(1.0)
let natural_logarithm = log(2.0)
let decimal_logarithm = log10(100.0)
let binary_logarithm = log2(8.0)
let sine = sin(0.5)
let cosine = cos(0.5)
let tangent = tan(0.5)

print(exponential)
print(natural_logarithm)
print(decimal_logarithm)
print(binary_logarithm)
print(sine)
print(cosine)
print(tangent)

let whole32: f32 = 25.0
let whole64: f64 = 25.0

print(25.0)
print(whole32)
print(whole64)
print(0.0)
print(-0.0)
print(-25.0)
